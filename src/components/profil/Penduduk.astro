---
// Section Penduduk pada halaman Profil.
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import StatCard from '../ui/StatCard.astro';
import { formatAngka } from '../../lib/format';

interface Props {
  penduduk: {
    jumlahJiwa: number | null;
    kepalaKeluarga: number | null;
    lakiLaki?: number | null;
    perempuan?: number | null;
    tahun: string;
    sumber: string;
  };
}

const { penduduk } = Astro.props;
---

<section id="penduduk" class="bg-white py-12 sm:py-16 lg:py-24">
  <Container>
    <SectionHeading overline="Penduduk" title="Data kependudukan" />
    <div class="mt-8 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4 lg:gap-6">
      <StatCard ikon="users" label="Jumlah penduduk" angka={formatAngka(penduduk.jumlahJiwa)} satuan="jiwa" />
      <StatCard ikon="house" label="Kepala keluarga" angka={formatAngka(penduduk.kepalaKeluarga)} />
      <StatCard ikon="users" label="Laki-laki" angka={formatAngka(penduduk.lakiLaki)} />
      <StatCard ikon="users" label="Perempuan" angka={formatAngka(penduduk.perempuan)} />
    </div>
    <p class="mt-6 text-sm text-ink-subtle">Sumber data: {penduduk.sumber}, {penduduk.tahun}</p>
  </Container>
</section>
