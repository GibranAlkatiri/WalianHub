---
// Satu baris berita ringkas tanpa foto, dipakai di daftar samping Beranda.
import Badge from './Badge.astro';
import Icon from './Icon.astro';
import { url } from '../../lib/url';
import { formatTanggal, tanggalIso } from '../../lib/format';
import type { KategoriBerita } from '../../lib/kategori-berita';

interface Props {
  judul: string;
  tanggal: Date;
  kategori: KategoriBerita;
  penting?: boolean;
  href: string;
}

const { judul, tanggal, kategori, penting = false, href } = Astro.props;
---

<article class="group relative flex h-full items-center gap-4 p-4 transition-colors hover:bg-sage-100 has-[a:focus-visible]:outline-3 has-[a:focus-visible]:-outline-offset-3 has-[a:focus-visible]:outline-forest-600 motion-reduce:transition-none sm:p-5">
  <div class="min-w-0 flex-1">
    <div class="flex flex-wrap items-center gap-2">
      <time datetime={tanggalIso(tanggal)} class="text-sm text-ink-subtle">{formatTanggal(tanggal)}</time>
      <Badge variant={kategori === 'Pengumuman' ? 'pengumuman' : 'kategori'}>{kategori}</Badge>
      {penting && <Badge variant="penting">Penting</Badge>}
    </div>
    <h3 class="mt-2 line-clamp-2 text-base leading-snug font-bold text-ink sm:text-lg">
      <a href={url(href)} class="after:absolute after:inset-0 focus-visible:outline-none">{judul}</a>
    </h3>
  </div>
  <Icon name="arrow-right" class="size-5 shrink-0 text-forest-600 transition-transform group-hover:translate-x-1 motion-reduce:transition-none" />
</article>
