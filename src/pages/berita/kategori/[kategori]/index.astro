---
// Halaman /berita/kategori/<slug>: berita satu kategori, halaman 1.
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import DaftarBerita from '../../../../components/berita/DaftarBerita.astro';
import { ambilBeritaTerbit, jumlahHalaman, potongHalaman } from '../../../../lib/berita';
import { namaKategori, slugKategori, type KategoriBerita } from '../../../../lib/kategori-berita';

export async function getStaticPaths() {
  return namaKategori.map((nama) => ({
    params: { kategori: slugKategori(nama) },
    props: { kategoriAktif: nama },
  }));
}

interface Props {
  kategoriAktif: KategoriBerita;
}

const { kategoriAktif } = Astro.props;

const semuaBerita = (await ambilBeritaTerbit()).filter((item) => item.data.kategori === kategoriAktif);
const totalHalaman = jumlahHalaman(semuaBerita.length);
const berita = potongHalaman(semuaBerita, 1);
---

<BaseLayout title={`Berita ${kategoriAktif}`} description="Berita, pengumuman, dan kegiatan terbaru dari Kelurahan Walian.">
  <DaftarBerita berita={berita} kategoriAktif={kategoriAktif} halaman={1} totalHalaman={totalHalaman} />
</BaseLayout>
