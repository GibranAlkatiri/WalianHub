---
// Halaman Profil: kepala halaman, Struktur Organisasi, Wilayah (termasuk penduduk), Visi dan Misi, lalu keterangan pembaruan.
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import KepalaHalaman from '../components/profil/KepalaHalaman.astro';
import StrukturOrganisasi from '../components/profil/StrukturOrganisasi.astro';
import Wilayah from '../components/profil/Wilayah.astro';
import VisiMisi from '../components/profil/VisiMisi.astro';
import { formatTanggal } from '../lib/format';

const profil = (await getEntry('profil', 'profil'))!.data;
---

<BaseLayout title="Profil" description="Struktur organisasi, wilayah, penduduk, serta visi dan misi Kelurahan Walian.">
  <KepalaHalaman ringkasan={profil.ringkasan} />
  <StrukturOrganisasi lurah={profil.lurah} strukturOrganisasi={profil.strukturOrganisasi} />
  <Wilayah sumberData={profil.sumberData} lingkungan={profil.lingkungan} />
  <VisiMisi visi={profil.visi} misi={profil.misi} programUnggulan={profil.programUnggulan} sumber={profil.sumberVisiMisi} />
  <Container>
    <p data-cms-profile-updated class="py-8 text-center text-sm text-ink-subtle">Terakhir diperbarui: {formatTanggal(profil.diperbarui)}</p>
  </Container>
</BaseLayout>
