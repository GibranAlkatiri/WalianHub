---
// Card berita: gambar 3:2, tanggal, kategori, judul, dan ringkasan.
// Seluruh card bisa diklik lewat tautan pada judul.
import SmartImage from './SmartImage.astro';
import Badge from './Badge.astro';
import Icon from './Icon.astro';
import { url } from '../../lib/url';
import { formatTanggal, tanggalIso } from '../../lib/format';

interface Props {
  judul: string;
  tanggal: Date;
  kategori: 'Pengumuman' | 'Kegiatan';
  ringkasan: string;
  gambar?: string;
  penting?: boolean;
  href: string;
}

const { judul, tanggal, kategori, ringkasan, gambar, penting = false, href } = Astro.props;
---

<article
  class="group relative flex h-full flex-col rounded-2xl bg-white p-3 shadow-card transition duration-200 hover:-translate-y-1 hover:shadow-float has-[a:focus-visible]:outline-3 has-[a:focus-visible]:outline-offset-2 has-[a:focus-visible]:outline-forest-600 motion-reduce:transition-none motion-reduce:hover:translate-y-0"
>
  <SmartImage src={gambar} alt={judul} class="aspect-[3/2] rounded-xl" />
  <div class="flex flex-1 flex-col px-2 pt-4 pb-2 lg:px-3">
    <div class="flex flex-wrap items-center gap-2">
      <time datetime={tanggalIso(tanggal)} class="text-sm text-ink-subtle">{formatTanggal(tanggal)}</time>
      <Badge variant={kategori === 'Pengumuman' ? 'pengumuman' : 'kategori'}>{kategori}</Badge>
      {penting && <Badge variant="penting">Penting</Badge>}
    </div>
    <h3 class="mt-3 line-clamp-2 text-lg leading-snug font-bold text-ink sm:text-xl">
      <a href={url(href)} class="after:absolute after:inset-0 after:rounded-2xl focus-visible:outline-none">{judul}</a>
    </h3>
    <p class="mt-2 line-clamp-2 text-base text-ink-muted">{ringkasan}</p>
    <span class="mt-auto inline-flex items-center gap-1 pt-4 text-base font-semibold text-forest-600" aria-hidden="true">
      Baca Selengkapnya
      <Icon name="arrow-right" class="size-4 transition-transform group-hover:translate-x-1 motion-reduce:transition-none" />
    </span>
  </div>
</article>
