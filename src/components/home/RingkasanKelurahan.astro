---
// Penyajian frontend untuk total wilayah dari data Profil yang sudah tersedia.
// Kartu demografi (donut + daftar agama) selalu tampil di bawah kartu
// Lingkungan dan Luas Wilayah, mengikuti siluet referensi: cakram bundar
// kiri menempel pada panel daftar kanan.
// Marker runtime memakai total yang sudah dihitung oleh publikasi CMS.
import type { CollectionEntry } from "astro:content";
import Container from "../ui/Container.astro";
import StatCard from "../ui/StatCard.astro";
import { formatAngka } from "../../lib/format";

type Profil = CollectionEntry<"profil">["data"];
type Beranda = CollectionEntry<"beranda">["data"];
interface Props {
  lingkungan: Profil["lingkungan"];
  jumlahPenduduk?: Beranda["jumlahPenduduk"];
  demografiAgama?: Beranda["demografiAgama"];
  runtimeTemplate?: boolean;
}
const {
  lingkungan,
  jumlahPenduduk = null,
  demografiAgama: mentahAgama,
  runtimeTemplate = false,
} = Astro.props;
const jumlahkan = (key: "luasKm2") => {
  const terisi = lingkungan
    .map((item) => item[key])
    .filter((angka): angka is number => angka != null);
  return terisi.length ? terisi.reduce((a, b) => a + b, 0) : null;
};

// Normalisasi object 6 agama ke daftar tampilan (3 teratas + Lainnya).
const labelAgama: Record<string, string> = {
  kristen: "Kristen",
  katolik: "Katolik",
  islam: "Islam",
  hindu: "Hindu",
  buddha: "Buddha",
  konghucu: "Konghucu",
};
const daftarAgama = Object.entries(mentahAgama ?? {}).map(
  ([kunci, jumlah]) => ({
    agama: labelAgama[kunci] ?? kunci,
    jumlah: jumlah || 0,
  }),
);
const totalJiwaAgama = daftarAgama.reduce(
  (acc, item) => acc + (item.jumlah || 0),
  0,
);
const totalJiwa =
  jumlahPenduduk ?? (totalJiwaAgama > 0 ? totalJiwaAgama : null);

const WARNA_AGAMA: Record<string, string> = {
  Islam: "#059669", // Hijau
  Kristen: "#2563eb", // Biru
  Katolik: "#eab308", // Kuning Emas
  Hindu: "#ea580c", // Oranye Safron
  Buddha: "#db2777", // Pink
  Konghucu: "#dc2626", // Merah
};
const WARNA_CADANGAN = [
  "#2563eb",
  "#7c3aed",
  "#059669",
  "#d97706",
  "#db2777",
  "#dc2626",
  "#0891b2",
  "#4f46e5",
];
const WARNA_LAINNYA = "#94a3b8";
// ponytail: warna netral tetap; ganti ke token palette saat token abu resmi tersedia.

const radius = 38;
const keliling = 2 * Math.PI * radius;
const basisTotal = totalJiwaAgama > 0 ? totalJiwaAgama : 1;

const terurut = [...daftarAgama].sort(
  (a, b) => (b.jumlah || 0) - (a.jumlah || 0),
);
const tigaTeratas = terurut.slice(0, 3);
const sisa = terurut.slice(3);
const tampilanAgama =
  sisa.length > 0
    ? [
        ...tigaTeratas,
        {
          agama: "Lainnya",
          jumlah: sisa.reduce((acc, item) => acc + (item.jumlah || 0), 0),
        },
      ]
    : tigaTeratas;
let offsetBerjalan = 0;
const dataAgama = tampilanAgama.map((item, index) => {
  const persen = totalJiwaAgama > 0 ? (item.jumlah / basisTotal) * 100 : 0;
  const panjangBusur = (persen / 100) * keliling;
  const offset = offsetBerjalan;
  if (persen > 0) offsetBerjalan += panjangBusur;
  const warna =
    item.agama === "Lainnya"
      ? WARNA_LAINNYA
      : WARNA_AGAMA[item.agama] ||
        WARNA_CADANGAN[index % WARNA_CADANGAN.length];
  return {
    ...item,
    persen,
    persenLabel:
      persen >= 10
        ? persen.toFixed(1).replace(/\.0$/, "")
        : persen > 0
          ? persen.toFixed(1)
          : "0",
    panjangBusur,
    offset,
    warna,
  };
});
---

<section
  id="ringkasan-kelurahan"
  aria-label="Ringkasan kelurahan"
  class="village-summary"
>
  <Container>
    <div class="village-summary-grid">
      <div class="village-summary-content">
        <div class="village-summary-stats">
          {
            runtimeTemplate ? (
              "__CMS_STATS__"
            ) : (
              <>
                <StatCard
                  ikon="map"
                  label="Lingkungan"
                  angka={lingkungan.length ? String(lingkungan.length) : null}
                />
                <StatCard
                  ikon="land-plot"
                  label="Luas wilayah"
                  angka={formatAngka(jumlahkan("luasKm2"))}
                  satuan="km²"
                />
              </>
            )
          }
        </div>
      </div>
      {
        runtimeTemplate ? (
          "__CMS_DEMOGRAFI__"
        ) : (
          <div class="demografi-card">
            <div class="demografi-head">
              <div
                class="demografi-donut-wrap"
                aria-label={`Total penduduk: ${formatAngka(totalJiwa) ?? "–"} jiwa`}
              >
                <svg
                  class="demografi-donut-svg"
                  viewBox="0 0 100 100"
                  aria-hidden="true"
                >
                  <circle
                    cx="50"
                    cy="50"
                    r={radius}
                    fill="none"
                    stroke="rgb(226 232 240 / 0.8)"
                    stroke-width="9"
                  />
                  {dataAgama.map(
                    (item) =>
                      item.persen > 0 && (
                        <circle
                          cx="50"
                          cy="50"
                          r={radius}
                          fill="none"
                          stroke={item.warna}
                          stroke-width="9"
                          stroke-dasharray={`${item.panjangBusur} ${keliling - item.panjangBusur}`}
                          stroke-dashoffset={-item.offset}
                          transform="rotate(-90 50 50)"
                          class="demografi-slice"
                        />
                      ),
                  )}
                </svg>
                <div class="demografi-pusat">
                  <span class="demografi-label-atas">Total</span>
                  <span class="demografi-angka">
                    {formatAngka(totalJiwa) ?? "–"}
                  </span>
                  <span class="demografi-label-bawah">Jumlah Jiwa</span>
                </div>
              </div>
            </div>
            <div class="demografi-body">
              <div class="demografi-daftar">
                {dataAgama.map((item) => (
                  <div class="demografi-row">
                    <div class="demografi-nama-wrap">
                      <span
                        class="demografi-dot"
                        style={`background-color: ${item.warna};`}
                      />
                      <span class="demografi-nama">{item.agama}</span>
                    </div>
                    <div class="demografi-track">
                      <div
                        class="demografi-bar"
                        style={`width: ${Math.max(item.persen, item.jumlah > 0 ? 2 : 0)}%; background-color: ${item.warna};`}
                      />
                    </div>
                    <span class="demografi-persen">{item.persenLabel}%</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        )
      }
    </div>
  </Container>
</section>

<style>
  .village-summary {
    position: relative;
    padding-bottom: 1.5rem;
  }
  /* Kartu statistik di atas, kartu demografi di bawahnya (satu kolom). */
  .village-summary-grid {
    display: grid;
    gap: 1rem;
  }
  /* Runtime CMS: kartu demografi hilang (data kosong) -> grid kolaps. */
  .village-summary-grid:has(> .village-summary-content:only-child) {
    gap: 0;
  }
  .village-summary-content {
    padding: 1.25rem;
    border: 1px solid rgb(255 255 255 / 0.8);
    border-radius: 1.5rem;
    background: var(--color-cream-50);
    box-shadow: 0 12px 32px rgb(31 51 22 / 0.12);
  }
  .village-summary-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 1rem;
  }
  .village-summary-stats :global([data-stat-card]) {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    column-gap: 0.625rem;
    background: transparent;
    border-radius: 0;
    padding: 0;
    box-shadow: none;
  }
  .village-summary-stats :global([data-stat-card] > span) {
    grid-row: 1 / 3;
    width: 2rem;
    height: 2rem;
  }
  .village-summary-stats :global([data-stat-value]) {
    margin: 0;
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    line-height: 1.3;
    font-variant-numeric: tabular-nums;
  }
  .village-summary-stats :global([data-stat-empty]) {
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .village-summary-stats :global([data-stat-unit]) {
    font-size: 0.6875rem;
  }
  .village-summary-stats :global([data-stat-label]) {
    margin: 0.25rem 0 0;
    font-size: 0.75rem;
    line-height: 1.5;
  }
  .village-summary-stats :global([data-stat-card] + [data-stat-card]) {
    border-left: 1px solid var(--color-line);
    padding-left: 1rem;
  }
  @media (min-width: 1024px) {
    .village-summary-content {
      padding: 1.5rem 2rem;
    }
    .village-summary-stats :global([data-stat-card]) {
      column-gap: 0.875rem;
    }
    .village-summary-stats :global([data-stat-card] > span) {
      width: 2.5rem;
      height: 2.5rem;
    }
    .village-summary-stats :global([data-stat-card] + [data-stat-card]) {
      padding-left: 1.5rem;
    }
    .village-summary-stats :global([data-stat-label]) {
      font-size: 0.8125rem;
    }
  }
</style>

<!-- CSS kartu demografi global: cocok dengan HTML injeksi runtime CMS
  (server/pengaturan-template.js) yang tanpa atribut scope Astro. -->
<style is:global>
  /* ── Kartu demografi: cakram bundar kiri + panel daftar kanan ── */
  .demografi-card {
    display: flex;
    align-items: center;
    max-width: 52rem;
    margin-inline: auto;
    width: 100%;
    position: relative;
    filter: drop-shadow(0 12px 32px rgb(31 51 22 / 0.1));
  }
  .demografi-head {
    position: relative;
    width: 12rem;
    height: 12rem;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #ffffff;
    border-radius: 9999px;
    z-index: 2;
  }
  .demografi-donut-wrap {
    position: relative;
    width: 9.5rem;
    height: 9.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .demografi-donut-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .demografi-slice {
    transition:
      stroke-dashoffset 0.6s ease,
      stroke-dasharray 0.6s ease;
  }
  .demografi-pusat {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    line-height: 1.2;
    pointer-events: none;
  }
  .demografi-label-atas {
    font-size: 0.8125rem;
    font-weight: 500;
    color: #64748b;
  }
  .demografi-angka {
    font-size: 1.75rem;
    font-weight: 800;
    color: #14532d;
    font-variant-numeric: tabular-nums;
    line-height: 1.15;
  }
  .demografi-label-bawah {
    font-size: 0.8125rem;
    font-weight: 500;
    color: #64748b;
  }
  .demografi-body {
    flex: 1;
    min-width: 0;
    background: #ffffff;
    border-radius: 0 1.25rem 1.25rem 0;
    margin-left: -3.7rem;
    padding: 1.25rem 1.5rem 1.25rem 3.5rem;
    min-height: 9.5rem;
    display: flex;
    align-items: center;
  }
  .demografi-daftar {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    width: 100%;
  }
  .demografi-row {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .demografi-nama-wrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 6.5rem;
    flex-shrink: 0;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  .demografi-dot {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 9999px;
    flex-shrink: 0;
  }
  .demografi-nama {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .demografi-track {
    flex: 1;
    min-width: 0;
    height: 0.625rem;
    background: rgb(0 0 0 / 0.07);
    border-radius: 9999px;
    overflow: hidden;
  }
  .demografi-bar {
    height: 100%;
    border-radius: 9999px;
    transition: width 0.5s ease;
  }
  .demografi-persen {
    min-width: 2.75rem;
    flex-shrink: 0;
    text-align: right;
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 639px) {
    .demografi-card {
      flex-direction: column;
      gap: 1rem;
      padding: 1.25rem 1rem;
      background: #ffffff;
      border-radius: 1.5rem;
      filter: drop-shadow(0 8px 24px rgb(31 51 22 / 0.1));
    }
    .demografi-head {
      width: 10rem;
      height: 10rem;
    }
    .demografi-donut-wrap {
      width: 10rem;
      height: 10rem;
    }
    .demografi-angka {
      font-size: 1.25rem;
    }
    .demografi-body {
      margin-left: 0;
      border-radius: 0;
      padding: 0;
      width: 100%;
      min-height: 0;
    }
    .demografi-row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.375rem 0.75rem;
    }
    .demografi-nama-wrap {
      min-width: 0;
      font-size: 0.875rem;
    }
    .demografi-track {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .demografi-persen {
      grid-column: 2;
      grid-row: 1;
      font-size: 0.875rem;
    }
  }
  @media (min-width: 640px) {
    .demografi-angka {
      font-size: 2rem;
    }
    .demografi-nama-wrap {
      font-size: 0.875rem;
      min-width: 7rem;
    }
    .demografi-persen {
      font-size: 0.875rem;
    }
  }
  @media (min-width: 1024px) {
    .demografi-head {
      width: 13rem;
      height: 13rem;
    }
    .demografi-donut-wrap {
      width: 10.25rem;
      height: 10.25rem;
    }
    .demografi-body {
      min-height: 10.5rem;
      padding: 1.5rem 2rem 1.5rem 4rem;
    }
  }
</style>
