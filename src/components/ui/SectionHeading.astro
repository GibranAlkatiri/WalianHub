---
// Judul section: overline, judul, dan deskripsi singkat.
// Rata tengah untuk section berisi card, rata kiri untuk section berisi teks.
interface Props {
  overline?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  class?: string;
}

const { overline, title, description, align = 'left', class: kelas } = Astro.props;
---

<div class:list={[align === 'center' ? 'mx-auto max-w-2xl text-center' : 'max-w-2xl', kelas]}>
  {overline && <p class="text-sm font-semibold tracking-widest text-forest-600 uppercase">{overline}</p>}
  <h2 class="mt-2 text-3xl leading-tight font-bold text-balance text-ink lg:text-4xl">{title}</h2>
  {description && <p class="mt-3 text-ink-muted">{description}</p>}
</div>
