---
// Ringkasan angka di dalam bagian Wilayah dan penduduk.
import type { CollectionEntry } from 'astro:content';
import StatCard from '../ui/StatCard.astro';
import { formatAngka } from '../../lib/format';
import { statistikKelurahan, cakupanStatistikKelurahan } from '../../lib/demografi';
interface Props {
  lingkungan: CollectionEntry<'profil'>['data']['lingkungan'];
  runtimeTemplate?: boolean;
}
const { lingkungan, runtimeTemplate = false } = Astro.props;
const stats = statistikKelurahan(lingkungan);
const cakupan = cakupanStatistikKelurahan(lingkungan);
const items = [
  { ikon: 'users', label: 'Kepala keluarga', angka: stats.family, satuan: 'KK' },
  { ikon: 'users', label: 'Penduduk', angka: stats.population, satuan: 'jiwa' },
  { ikon: 'map', label: 'Lingkungan', angka: stats.environment },
  { ikon: 'land-plot', label: 'Luas wilayah', angka: stats.area, satuan: 'km²' },
].filter((item) => item.angka !== null);
---
<div id="ringkasan-kelurahan" data-cms-summary role="group" aria-label="Ringkasan wilayah dan penduduk" class="village-summary" hidden={!runtimeTemplate && !items.length}>
  <div class="village-summary-stats">
    {runtimeTemplate ? '__CMS_STATS__' : items.map((item) => <StatCard {...item} angka={formatAngka(item.angka)} />)}
  </div>
  <p data-stats-coverage class="mt-4 text-sm text-ink-subtle" hidden={!runtimeTemplate && !cakupan}>
    {runtimeTemplate ? '__CMS_STATS_COVERAGE__' : `Jumlah dari data yang sudah diisi. ${cakupan}.`}
  </p>
</div>
<style>
  .village-summary { margin-top: 1.5rem; padding: 1.25rem; border: 1px solid var(--color-line); border-radius: 1rem; background: white; }
  .village-summary-stats { display: flex; flex-wrap: wrap; gap: 1.25rem 3rem; }
  .village-summary-stats :global([data-stat-card]) { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; column-gap: 0.75rem; min-width: 9rem; padding: 0; border-radius: 0; background: transparent; box-shadow: none; }
  .village-summary-stats :global([data-stat-card] > span) { grid-row: 1 / 3; width: 2.5rem; height: 2.5rem; }
  .village-summary-stats :global([data-stat-value]) { margin: 0; font-size: 1.5rem; line-height: 1.3; font-variant-numeric: tabular-nums; }
  .village-summary-stats :global([data-stat-unit]) { font-size: 0.75rem; }
  .village-summary-stats :global([data-stat-label]) { margin: 0.125rem 0 0; font-size: 0.8125rem; }
  @media (max-width: 479px) { .village-summary-stats { gap: 1.25rem; } }
</style>
