{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "walianhub-media-cleanup",
  "main": "media-cleanup.js",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["0 19 * * *"] },
  "vars": { "CMS_MEDIA_CLEANUP_URL": "https://walianhub-8ib.pages.dev/api/media-cleanup" },
  "observability": { "enabled": true }
}
