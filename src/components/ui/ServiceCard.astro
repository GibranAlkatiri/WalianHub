---
// Card layanan: ikon, nama layanan, dan satu kalimat.
// Seluruh card bisa diklik lewat tautan pada judul.
import Icon from './Icon.astro';
import { url } from '../../lib/url';

interface Props {
  judul: string;
  ringkasan: string;
  ikon: string;
  href: string;
  motion?: 'fade' | 'card';
  /** Penanda untuk template statis yang diisi Pages Function saat request. */
  runtimeTemplate?: boolean;
}

const { judul, ringkasan, ikon, href, motion = 'card', runtimeTemplate = false } = Astro.props;
---

<article
  data-motion={motion === 'card' ? 'card' : ''}
  data-motion-card
  class="group relative flex h-full flex-col rounded-2xl bg-white p-4 shadow-card sm:p-5 transition-[translate,box-shadow] duration-[437.5ms] ease-in-out hover:-translate-y-0.5 hover:shadow-float focus-within:shadow-float has-[a:focus-visible]:outline-3 has-[a:focus-visible]:outline-offset-2 has-[a:focus-visible]:outline-forest-600 motion-reduce:transition-none motion-reduce:hover:translate-y-0 lg:p-6"
>
  <span class="grid size-12 place-items-center rounded-full bg-sage-100 text-forest-600">
    {runtimeTemplate ? <Fragment set:html="__CMS_ICON__" /> : <Icon name={ikon} class="size-6" />}
  </span>
  <h3 class="mt-3 text-lg leading-snug font-bold text-ink sm:mt-4 sm:text-xl">
    <a href={url(href)} class="after:absolute after:inset-0 after:rounded-2xl focus-visible:outline-none">{judul}</a>
  </h3>
  <p class="mt-2 line-clamp-3 text-base text-ink-muted">{ringkasan}</p>
  <span class="mt-auto inline-flex items-center gap-1 pt-4 text-base font-semibold text-forest-600" aria-hidden="true">
    Lihat syarat
    <Icon name="arrow-right" class="size-4 transition-transform motion-safe:group-hover:translate-x-1 motion-safe:group-focus-within:translate-x-1 motion-reduce:transition-none" />
  </span>
</article>
