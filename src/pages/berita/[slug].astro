---
// Halaman detail satu berita, dengan 3 berita lainnya di bawahnya.
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import SmartImage from '../../components/ui/SmartImage.astro';
import Badge from '../../components/ui/Badge.astro';
import Icon from '../../components/ui/Icon.astro';
import Button from '../../components/ui/Button.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import NewsCard from '../../components/ui/NewsCard.astro';
import { url } from '../../lib/url';
import { formatTanggal, tanggalIso } from '../../lib/format';
import { ambilBeritaTerbit, alamatDaftarBerita } from '../../lib/berita';
import { slugKategori } from '../../lib/kategori-berita';

export async function getStaticPaths() {
  const berita = await ambilBeritaTerbit();
  return berita.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const berita = entry.data;
const { Content } = await render(entry);

const gambarPreview = /\.(jpe?g|png|webp)$/i.test(berita.gambar ?? '') ? berita.gambar : undefined;

const beritaLainnya = (await ambilBeritaTerbit()).filter((item) => item.id !== entry.id).slice(0, 3);
---

<BaseLayout title={berita.judul} description={berita.ringkasan} image={gambarPreview}>
  <Container>
    <article class="mx-auto max-w-3xl pt-8 pb-16 sm:pt-10 lg:pt-12 lg:pb-20">
      <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-sm text-ink-subtle">
        <a href={url('/')} class="hover:text-forest-600 hover:underline">Beranda</a>
        <span aria-hidden="true">/</span>
        <a href={url('/berita')} class="hover:text-forest-600 hover:underline">Berita</a>
        <span aria-hidden="true">/</span>
        <a href={url(alamatDaftarBerita(slugKategori(berita.kategori)))} class="hover:text-forest-600 hover:underline">
          {berita.kategori}
        </a>
      </nav>

      <div class="mt-4 flex flex-wrap items-center gap-3">
        <span class="inline-flex items-center gap-1.5 text-sm text-ink-subtle">
          <Icon name="calendar" class="size-4" />
          <time datetime={tanggalIso(berita.tanggal)}>{formatTanggal(berita.tanggal)}</time>
        </span>
        <Badge variant={berita.kategori === 'Pengumuman' ? 'pengumuman' : 'kategori'}>{berita.kategori}</Badge>
        {berita.penting && <Badge variant="penting">Penting</Badge>}
      </div>

      <h1 class="mt-4 text-3xl leading-tight font-extrabold text-balance text-ink sm:text-4xl">{berita.judul}</h1>
      <p class="mt-4 text-lg text-ink-muted">{berita.ringkasan}</p>

      <figure class="mt-8">
        <SmartImage src={berita.gambar} alt={berita.judul} class="aspect-[16/9] rounded-2xl" />
        {berita.keteranganGambar && <figcaption class="mt-2 text-sm text-ink-subtle">{berita.keteranganGambar}</figcaption>}
      </figure>

      <div class="isi-berita mt-8">
        <Content />
      </div>

      <Button href="/berita" variant="outline" icon="arrow-left" class="mt-10">Kembali ke Semua Berita</Button>
    </article>
  </Container>

  {
    beritaLainnya.length > 0 && (
      <section class="bg-sage-100 py-12 sm:py-16 lg:py-20">
        <Container>
          <SectionHeading overline="Berita" title="Berita lainnya" />
          <div class="mt-8 grid gap-4 sm:mt-10 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6">
            {beritaLainnya.map((item) => (
              <NewsCard
                judul={item.data.judul}
                tanggal={item.data.tanggal}
                kategori={item.data.kategori}
                ringkasan={item.data.ringkasan}
                gambar={item.data.gambar}
                penting={item.data.penting}
                href={`/berita/${item.id}`}
              />
            ))}
          </div>
          <div class="mt-8 flex justify-center sm:mt-10">
            <Button href="/berita" variant="outline">Semua Berita</Button>
          </div>
        </Container>
      </section>
    )
  }
</BaseLayout>
