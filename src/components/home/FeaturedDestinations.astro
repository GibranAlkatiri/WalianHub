---
// Section 4 Beranda: destinasi unggulan. Anchor #wisata.
// Sampai empat destinasi: tampilkan semua. Mulai lima: empat pilihan dan tautan halaman daftar.
// Di HP, card bisa digeser ke samping (carousel) dengan titik penanda di bawahnya.
import { wisata } from '../../lib/data-wisata';
import { tautanPetaDestinasi } from '../../lib/wisata';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import DestinationCard from '../ui/DestinationCard.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

const destinasi = wisata.pilihan;
---

<section id="wisata" class="bg-sage-100 py-12 sm:py-16 lg:py-24">
  <Container>
    <SectionHeading
      align="center"
      overline="Wisata"
      title="Destinasi unggulan Walian"
      description="Tempat-tempat menarik di Kelurahan Walian yang bisa Anda kunjungi."
    />

    {destinasi.length === 0 ? (
      <p class="mt-8 rounded-2xl bg-white p-8 text-center text-ink-muted shadow-card">Informasi destinasi wisata sedang disiapkan.</p>
    ) : <div data-carousel class="mt-8 lg:mt-10">
      <div
        data-carousel-lintasan
        id="carousel-destinasi"
        data-motion-group
        class:list={[
          'relative -mx-4 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 py-4 [scrollbar-width:none] md:mx-0 md:grid md:grid-cols-2 md:overflow-visible md:px-0 md:py-0 lg:gap-6 [&::-webkit-scrollbar]:hidden',
          destinasi.length === 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3',
        ]}
      >
        {
          destinasi.map((item) => (
            <div class="w-[85%] max-w-sm shrink-0 snap-center md:w-auto md:max-w-none">
              <DestinationCard
                nama={item.data.nama}
                kategori={item.data.kategori}
                ringkasan={item.data.ringkasan}
                gambar={item.data.gambar}
                href={tautanPetaDestinasi(item.data.lokasi, item.data.lokasi.alamat)}
              />
            </div>
          ))
        }
      </div>
      <div data-carousel-kontrol hidden role="group" aria-label="Kontrol destinasi wisata" class="mt-2 flex items-center justify-center gap-1 md:hidden">
        <button type="button" data-carousel-sebelumnya aria-label="Destinasi sebelumnya" aria-controls="carousel-destinasi" class="grid size-10 place-items-center rounded-full border border-line bg-white text-forest-700 transition-colors hover:bg-sage-200 disabled:cursor-default disabled:opacity-40">
          <Icon name="arrow-right" class="size-4 rotate-180" />
        </button>
        {
          destinasi.map((item, i) => (
            <button type="button" data-carousel-titik={i} data-aktif={i === 0 ? '' : undefined} aria-label={`Tampilkan destinasi ${i + 1}: ${item.data.nama}`} aria-current={i === 0 ? 'true' : undefined} aria-controls="carousel-destinasi" class="group/titik grid size-10 place-items-center rounded-full">
              <span class="size-2.5 rounded-full bg-line transition-colors group-data-[aktif]/titik:bg-forest-600"></span>
            </button>
          ))
        }
        <button type="button" data-carousel-berikutnya aria-label="Destinasi berikutnya" aria-controls="carousel-destinasi" class="grid size-10 place-items-center rounded-full border border-line bg-white text-forest-700 transition-colors hover:bg-sage-200 disabled:cursor-default disabled:opacity-40">
          <Icon name="arrow-right" class="size-4" />
        </button>
        <span data-carousel-status aria-live="polite" aria-atomic="true" class="sr-only">Destinasi 1 dari {destinasi.length}</span>
      </div>
    </div>}

    {
      wisata.pakaiHalaman && (
        <div class="mt-8 text-center sm:mt-10">
          <Button href="/wisata" variant="outline">Semua Wisata</Button>
        </div>
      )
    }
  </Container>
</section>

<script>
  import { mulaiCarousel } from '../../lib/carousel';
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach(mulaiCarousel);
</script>
