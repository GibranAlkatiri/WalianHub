---
// Header melayang yang tampil di semua halaman.
// Menu lengkap tampil mulai lebar 1280px; di bawahnya memakai hamburger menu.
// Ukuran logo, tombol bahasa, dan hamburger dibuat ringkas di HP agar muat di layar 360px.
import Logo from './Logo.astro';
import LanguageToggle from './LanguageToggle.astro';
import MobileMenu from './MobileMenu.astro';
import Button from '../ui/Button.astro';
import { menuUtama, tautanKontak } from '../../lib/navigasi';
import { url } from '../../lib/url';
import { SIAP_DIINDEKS } from '../../lib/konfigurasi';

interface Props {
  namaKelurahan: string;
  kota: string;
}

const { namaKelurahan, kota } = Astro.props;

const halamanIni = Astro.url.pathname.replace(/\/$/, '');
const aktif = (href: string) => url(href).replace(/\/$/, '') === halamanIni;
---

<header class="fixed inset-x-0 top-0 z-50 px-2 pt-2 sm:px-3 sm:pt-3 lg:px-6 lg:pt-4">
  {
    !SIAP_DIINDEKS && (
      <p class="mx-auto mb-2 w-fit rounded-full bg-sun-100 px-3 py-1 text-xs font-semibold text-sun-700 shadow-card sm:text-sm">
        Versi pratinjau · isi masih contoh
      </p>
    )
  }
  <div
    class="relative mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 rounded-2xl bg-white/95 px-2.5 shadow-float backdrop-blur sm:px-3 lg:h-18 lg:px-5"
  >
    <Logo nama={namaKelurahan} keterangan={`Kota ${kota}`} />

    <nav aria-label="Menu utama" class="hidden xl:block">
      <ul class="flex items-center gap-1">
        {
          menuUtama.map((item) => (
            <li>
              <a
                href={url(item.href)}
                aria-current={aktif(item.href) ? 'page' : undefined}
                class:list={[
                  'rounded-full px-3 py-2 text-base font-medium transition-colors hover:text-forest-600',
                  aktif(item.href) ? 'text-forest-600 underline decoration-2 underline-offset-8' : 'text-ink',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-1.5 sm:gap-2">
      <LanguageToggle />
      <div class="hidden xl:block">
        <Button href={tautanKontak}>Hubungi Kami</Button>
      </div>
      <MobileMenu menu={menuUtama} tautanKontak={tautanKontak} />
    </div>
  </div>
</header>
