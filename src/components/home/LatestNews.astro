---
// Section 2 Beranda: 1 berita terbaru tampil besar, lalu 3 berita berikutnya dalam daftar ringkas.
// Anchor #berita, juga tujuan tanda gulir di hero.
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import NewsCard from '../ui/NewsCard.astro';
import NewsListItem from '../ui/NewsListItem.astro';
import Button from '../ui/Button.astro';
import { ambilBeritaTerbit } from '../../lib/berita';

const berita = (await ambilBeritaTerbit()).slice(0, 4);
const [utama, ...lainnya] = berita;
---

<section id="berita" class="py-12 sm:py-16 lg:py-24">
  <Container>
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <SectionHeading
        overline="Berita"
        title="Berita dan pengumuman terbaru"
        description="Kegiatan dan pengumuman terbaru dari Kelurahan Walian."
      />
      <div class="shrink-0">
        <Button href="/berita" variant="outline">Semua Berita</Button>
      </div>
    </div>

    {
      utama ? (
        <div class="mt-8 grid gap-4 sm:mt-10 lg:grid-cols-5 lg:gap-6">
          <div class:list={[lainnya.length > 0 ? 'lg:col-span-3' : 'lg:col-span-5']}>
            <NewsCard
              judul={utama.data.judul}
              tanggal={utama.data.tanggal}
              kategori={utama.data.kategori}
              ringkasan={utama.data.ringkasan}
              gambar={utama.data.gambar}
              penting={utama.data.penting}
              href={`/berita/${utama.id}`}
              utama
            />
          </div>
          {lainnya.length > 0 && (
            <ul role="list" class="flex flex-col divide-y divide-line overflow-hidden rounded-2xl bg-white shadow-card lg:col-span-2">
              {lainnya.map((item) => (
                <li class="flex-1">
                  <NewsListItem
                    judul={item.data.judul}
                    tanggal={item.data.tanggal}
                    kategori={item.data.kategori}
                    penting={item.data.penting}
                    href={`/berita/${item.id}`}
                  />
                </li>
              ))}
            </ul>
          )}
        </div>
      ) : (
        <div class="mt-8 rounded-2xl bg-white p-8 text-center text-ink-muted shadow-card sm:mt-10">Belum ada berita.</div>
      )
    }
  </Container>
</section>
