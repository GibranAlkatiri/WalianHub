---
// Alamat ini selalu tersedia agar tautan lama tetap bisa dibuka saat jumlah destinasi berkurang.
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import DestinationCard from '../components/ui/DestinationCard.astro';
import { wisata } from '../lib/data-wisata';
import { tautanPetaDestinasi } from '../lib/wisata';
import { url } from '../lib/url';
import { formatTanggal } from '../lib/format';

const diperbarui = wisata.semua.length > 0
  ? new Date(Math.max(...wisata.semua.map((item) => item.data.diperbarui.getTime())))
  : null;
---

<BaseLayout title="Wisata" description="Tempat wisata di Kelurahan Walian, beserta foto, informasi singkat, dan lokasi di Google Maps.">
  <section class="pt-8 pb-12 sm:pt-10 sm:pb-16 lg:pt-12 lg:pb-20">
    <Container>
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-sm text-ink-subtle">
        <a href={url('/')} class="hover:text-forest-600 hover:underline">Beranda</a>
        <span aria-hidden="true">/</span>
        <span class="text-ink" aria-current="page">Wisata</span>
      </nav>
      <h1 class="mt-4 text-3xl leading-tight font-extrabold text-balance text-ink sm:text-4xl">Wisata Walian</h1>
      <p class="mt-4 max-w-2xl text-ink-muted">Kenali tempat-tempat menarik di Kelurahan Walian. Tekan "Cek Lokasi" untuk melihat titik destinasi di Google Maps.</p>
    </Container>
  </section>

  <section class="bg-sage-100 py-12 sm:py-16 lg:py-24">
    <Container>
      <SectionHeading overline="Wisata" title="Daftar destinasi" />
      {wisata.semua.length > 0 ? (
        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6">
          {wisata.semua.map((item) => (
            <DestinationCard
              nama={item.data.nama}
              kategori={item.data.kategori}
              ringkasan={item.data.ringkasan}
              gambar={item.data.gambar}
              href={tautanPetaDestinasi(item.data.lokasi)}
            />
          ))}
        </div>
      ) : (
        <p class="mt-8 rounded-2xl bg-white p-8 text-center text-ink-muted shadow-card">Informasi destinasi wisata sedang disiapkan.</p>
      )}
    </Container>
  </section>

  {diperbarui && (
    <Container>
      <p class="py-8 text-center text-sm text-ink-subtle">Terakhir diperbarui: {formatTanggal(diperbarui)}</p>
    </Container>
  )}
</BaseLayout>
