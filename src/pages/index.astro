---
// Beranda (landing page): enam section, dari hero sampai kontak dan peta.
// Semua isinya diambil dari src/content/.
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import QuickAccess from '../components/home/QuickAccess.astro';
import LatestNews from '../components/home/LatestNews.astro';
import Services from '../components/home/Services.astro';
import FeaturedDestinations from '../components/home/FeaturedDestinations.astro';
import Contact from '../components/home/Contact.astro';

const situs = (await getEntry('situs', 'situs'))!.data;
const beranda = (await getEntry('beranda', 'beranda'))!.data;

// Link preview hanya bisa memakai foto JPG/PNG/WebP. Selama hero memakai gambar default (SVG),
// BaseLayout otomatis memakai default-og.png.
const gambarPreview = /\.(jpe?g|png|webp)$/i.test(beranda.hero.gambar ?? '') ? beranda.hero.gambar : undefined;
---

<BaseLayout overlayHeader image={gambarPreview}>
  <Hero hero={beranda.hero} />
  <QuickAccess items={beranda.aksesCepat} />
  <LatestNews />
  <Services />
  <FeaturedDestinations />
  <Contact situs={situs} />
</BaseLayout>
