---
// Beranda: konten kelurahan dari src/content/, identitas tim KKT tetap di frontend.
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import KktTeam from '../components/home/KktTeam.astro';
import ProfileIntro from '../components/home/ProfileIntro.astro';
import Services from '../components/home/Services.astro';
import FeaturedDestinations from '../components/home/FeaturedDestinations.astro';
import Contact from '../components/home/Contact.astro';

const situs = (await getEntry('situs', 'situs'))!.data;
const beranda = (await getEntry('beranda', 'beranda'))!.data;
const profil = (await getEntry('profil', 'profil'))!.data;

// Link preview hanya bisa memakai foto JPG/PNG/WebP. Jika hero belum punya foto seperti itu,
// BaseLayout otomatis memakai default-og.png.
const fotoPertama = beranda.hero.foto.find((foto) => foto.gambar.trim())?.gambar;
const gambarPreview = fotoPertama && /\.(jpe?g|png|webp)$/i.test(fotoPertama) ? fotoPertama : undefined;
---

<BaseLayout overlayHeader image={gambarPreview}>
  <Hero hero={beranda.hero} ringkasanKelurahan={{ lingkungan: profil.lingkungan, jumlahPenduduk: beranda.jumlahPenduduk, demografiAgama: beranda.demografiAgama }} />
  <KktTeam />
  <ProfileIntro ringkasan={profil.ringkasan} lurah={profil.lurah} />
  <Services />
  <FeaturedDestinations />
  <Contact situs={situs} />
</BaseLayout>
