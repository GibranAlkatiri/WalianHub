---
// Penyajian frontend untuk total wilayah dan demografi agama dari data Profil.
// Marker runtime memakai total yang sudah dihitung oleh publikasi CMS.
import type { CollectionEntry } from 'astro:content';
import Container from '../ui/Container.astro';
import StatCard from '../ui/StatCard.astro';
import { formatAngka } from '../../lib/format';

type Profil = CollectionEntry<'profil'>['data'];
type Beranda = CollectionEntry<'beranda'>['data'];
interface Props {
  lingkungan: Profil['lingkungan'];
  jumlahPenduduk?: number | null;
  demografiAgama?: Beranda['demografiAgama'];
  runtimeTemplate?: boolean;
}
const { lingkungan, jumlahPenduduk = null, demografiAgama: mentahAgama = { kristen: 0, katolik: 0, islam: 0, hindu: 0, buddha: 0, konghucu: 0 }, runtimeTemplate = false } = Astro.props;

// Normalisasi object 6 agama (+fallback array lama) ke daftar tampilan.
const labelAgama: Record<string, string> = {
  kristen: 'Kristen',
  katolik: 'Katolik',
  islam: 'Islam',
  hindu: 'Hindu',
  buddha: 'Buddha',
  konghucu: 'Konghucu',
};
const demografiAgama = Array.isArray(mentahAgama)
  ? mentahAgama
  : Object.entries(mentahAgama ?? {}).map(([kunci, jumlah]) => ({ agama: labelAgama[kunci] ?? kunci, jumlah: jumlah || 0 }));

const jumlahkan = (key: 'kepalaKeluarga' | 'jumlahPenduduk' | 'luasKm2') => {
  const terisi = lingkungan.map(item => item[key]).filter((angka): angka is number => angka != null);
  return terisi.length ? terisi.reduce((a, b) => a + b, 0) : null;
};

// Hitung total penduduk dan persentase agama
const totalPendudukLingkungan = jumlahkan('jumlahPenduduk');
const totalJiwaAgama = demografiAgama.reduce((acc, item) => acc + (item.jumlah || 0), 0);
const totalPenduduk = jumlahPenduduk ?? totalPendudukLingkungan ?? (totalJiwaAgama > 0 ? totalJiwaAgama : null);

const WARNA_AGAMA: Record<string, string> = {
  'Kristen': '#2563eb',
  'Kristen Protestan': '#2563eb',
  'Katolik': '#7c3aed',
  'Islam': '#059669',
  'Hindu': '#d97706',
  'Buddha': '#db2777',
  'Konghucu': '#dc2626',
};
const WARNA_CADANGAN = ['#2563eb', '#7c3aed', '#059669', '#d97706', '#db2777', '#dc2626', '#0891b2', '#4f46e5'];

const WARNA_LAINNYA = '#94a3b8';
// ponytail: warna netral tetap; ganti ke token palette saat token abu resmi tersedia.

const radius = 38;
const keliling = 2 * Math.PI * radius; // ~238.76

const basisTotal = totalJiwaAgama > 0 ? totalJiwaAgama : 1;

// Urutkan menurun, ambil 3 teratas, gabung sisanya jadi "Lainnya".
const terurut = [...demografiAgama].sort((a, b) => (b.jumlah || 0) - (a.jumlah || 0));
const tigaTeratas = terurut.slice(0, 3);
const sisa = terurut.slice(3);
const tampilanAgama =
  sisa.length > 0
    ? [...tigaTeratas, { agama: 'Lainnya', jumlah: sisa.reduce((acc, item) => acc + (item.jumlah || 0), 0) }]
    : tigaTeratas;
let offsetBerjalan = 0;

const dataAgama = tampilanAgama.map((item, index) => {
  const persen = totalJiwaAgama > 0 ? (item.jumlah / basisTotal) * 100 : 0;
  const panjangBusur = (persen / 100) * keliling;
  const offset = offsetBerjalan;
  if (persen > 0) {
    offsetBerjalan += panjangBusur;
  }
  const warna = item.agama === 'Lainnya' ? WARNA_LAINNYA : (WARNA_AGAMA[item.agama] || WARNA_CADANGAN[index % WARNA_CADANGAN.length]);
  return {
    ...item,
    persen,
    persenLabel: persen >= 10 ? persen.toFixed(1).replace(/\.0$/, '') : (persen > 0 ? persen.toFixed(1) : '0'),
    panjangBusur,
    offset,
    warna,
  };
});
---

<section id="ringkasan-kelurahan" aria-label="Ringkasan kelurahan" class="village-summary">
  <Container>
    <!-- Ringkasan Lingkungan dan Luas Wilayah (2 stat saja) -->
    <div class="village-summary-content">
      <div class="village-summary-stats">
        {runtimeTemplate ? '__CMS_STATS__' : <>
          <StatCard ikon="map" label="Lingkungan" angka={lingkungan.length ? String(lingkungan.length) : null} />
          <StatCard ikon="land-plot" label="Luas wilayah" angka={formatAngka(jumlahkan('luasKm2'))} satuan="km²" />
        </>}
      </div>
    </div>

    <!-- Demografi Penduduk & Agama (Siluet Terpadu: Donut Kiri + Statistik Kanan) -->
    {runtimeTemplate ? '__CMS_DEMOGRAFI__' : dataAgama.length > 0 && (
      <div class="demografi-capsule">
        <!-- Kepala Kiri: Bulatan Donut dengan transisi fillet -->
        <div class="demografi-head">
          <svg class="demografi-head-bg" viewBox="0 0 240 232" preserveAspectRatio="none" aria-hidden="true">
            <path
              d="M 240 24 L 210 24 C 185 24 175 16 160 10 C 148 4 133 0 116 0 A 116 116 0 0 0 116 232 C 133 232 148 228 160 222 C 175 216 185 208 210 208 L 240 208 Z"
              fill="#ffffff"
            />
          </svg>

          <!-- Donut chart -->
          <div class="demografi-donut-wrap" aria-label={`Total penduduk: ${formatAngka(totalPenduduk) ?? '–'} jiwa`}>
            <svg class="demografi-donut-svg" viewBox="0 0 100 100" aria-hidden="true">
              <circle
                cx="50"
                cy="50"
                r={radius}
                fill="none"
                stroke="rgb(226 232 240 / 0.8)"
                stroke-width="9"
              />
              {dataAgama.map((item) => item.persen > 0 && (
                <circle
                  cx="50"
                  cy="50"
                  r={radius}
                  fill="none"
                  stroke={item.warna}
                  stroke-width="9"
                  stroke-dasharray={`${item.panjangBusur} ${keliling - item.panjangBusur}`}
                  stroke-dashoffset={-item.offset}
                  transform="rotate(-90 50 50)"
                  class="demografi-slice"
                />
              ))}
            </svg>

            <!-- Teks Tengah: Total, Angka, Jumlah Jiwa -->
            <div class="demografi-pusat">
              <span class="demografi-label-atas">Total</span>
              <span class="demografi-angka">{formatAngka(totalPenduduk) ?? '–'}</span>
              <span class="demografi-label-bawah">Jumlah Jiwa</span>
            </div>
          </div>
        </div>

        <!-- Badan Kanan: Kolom Statistik Persen (3 kolom per baris) -->
        <div class="demografi-body">
          <div class="demografi-daftar">
            {dataAgama.map((item) => (
              <div class="demografi-row">
                <div class="demografi-nama-wrap">
                  <span class="demografi-dot" style={`background-color: ${item.warna};`}></span>
                  <span class="demografi-nama">{item.agama}</span>
                </div>
                <div class="demografi-track">
                  <div
                    class="demografi-bar"
                    style={`width: ${Math.max(item.persen, item.jumlah > 0 ? 2 : 0)}%; background-color: ${item.warna};`}
                  ></div>
                </div>
                <span class="demografi-persen">{item.persenLabel}%</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    )}
  </Container>
</section>

<style>
  .village-summary {
    position: relative;
    padding-bottom: 1.5rem;
  }
  .village-summary-content {
    padding: 1.25rem;
    border: 1px solid rgb(255 255 255 / 0.8);
    border-radius: 1.5rem;
    background: var(--color-cream-50);
    box-shadow: 0 12px 32px rgb(31 51 22 / 0.12);
  }
  .village-summary-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 1rem;
  }
  .village-summary-stats :global([data-stat-card]) {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    column-gap: 0.625rem;
    background: transparent;
    border-radius: 0;
    padding: 0;
    box-shadow: none;
  }
  .village-summary-stats :global([data-stat-card] > span) {
    grid-row: 1 / 3;
    width: 2rem;
    height: 2rem;
  }
  .village-summary-stats :global([data-stat-value]) {
    margin: 0;
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    line-height: 1.3;
    font-variant-numeric: tabular-nums;
  }
  .village-summary-stats :global([data-stat-empty]) {
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .village-summary-stats :global([data-stat-unit]) { font-size: 0.6875rem; }
  .village-summary-stats :global([data-stat-label]) {
    font-size: 0.75rem;
    line-height: 1.3;
    color: var(--color-ink-muted);
  }
  @media (min-width: 640px) {
    .village-summary-stats :global([data-stat-card] + [data-stat-card]) {
      border-left: 1px solid var(--color-line);
      padding-left: 1rem;
    }
  }
  @media (min-width: 1024px) {
    .village-summary-content { padding: 1.5rem; }
    .village-summary-stats :global([data-stat-card]) { column-gap: 0.875rem; }
    .village-summary-stats :global([data-stat-card] > span) { width: 2.5rem; height: 2.5rem; }
    .village-summary-stats :global([data-stat-card] + [data-stat-card]) { padding-left: 1.5rem; }
    .village-summary-stats :global([data-stat-label]) { font-size: 0.8125rem; }
  }

  /* ── Demografi Capsule (Siluet Terpadu Sesuai Gambar Referensi) ── */
  .demografi-capsule {
    display: flex;
    align-items: center;
    max-width: 52rem;
    margin: 1.75rem auto 0;
    position: relative;
    filter: drop-shadow(0 12px 32px rgb(31 51 22 / 0.09));
  }

  /* Kepala Kiri: Bulatan Donut + Transisi Lekukan */
  .demografi-head {
    position: relative;
    width: 15rem;
    height: 14.5rem;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }

  .demografi-head-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: -1;
  }

  .demografi-donut-wrap {
    position: relative;
    width: 11rem;
    height: 11rem;
    margin-right: 1.5rem; /* Posisi tepat di tengah bulatan kiri */
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .demografi-donut-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .demografi-slice {
    transition: stroke-dashoffset 0.6s ease, stroke-dasharray 0.6s ease;
  }

  /* Teks Tengah: Total / Angka / Jumlah Jiwa */
  .demografi-pusat {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    pointer-events: none;
    z-index: 1;
    padding: 0.25rem;
  }

  .demografi-label-atas {
    font-size: 0.8125rem;
    font-weight: 500;
    color: #64748b;
    line-height: 1;
  }

  .demografi-angka {
    font-size: clamp(1.75rem, 2.5vw, 2.25rem);
    font-weight: 800;
    line-height: 1.15;
    color: #166534;
    font-variant-numeric: tabular-nums;
    margin: 0.2rem 0;
  }

  .demografi-label-bawah {
    font-size: 0.8125rem;
    font-weight: 500;
    color: #64748b;
    line-height: 1;
  }

  /* Badan Kanan: Kolom Statistik Persen */
  .demografi-body {
    flex: 1;
    min-width: 0;
    background: #ffffff;
    border-radius: 0 1.25rem 1.25rem 0;
    margin-left: -1px; /* Sambungan presisi tanpa celah */
    min-height: 11.5rem; /* Tinggi pas dengan y=24 sampai y=208 di kepala */
    padding: 1.5rem 2.25rem 1.5rem 0.75rem;
    display: flex;
    align-items: center;
    z-index: 1;
  }

  .demografi-daftar {
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
    width: 100%;
  }

  .demografi-row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .demografi-nama-wrap {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-width: 7.5rem;
    flex-shrink: 0;
  }

  .demografi-dot {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 9999px;
    flex-shrink: 0;
  }

  .demografi-nama {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .demografi-track {
    flex: 1;
    height: 0.625rem;
    background: #f1f5f9;
    border-radius: 9999px;
    overflow: hidden;
  }

  .demografi-bar {
    height: 100%;
    border-radius: 9999px;
    transition: width 0.5s ease;
  }

  .demografi-persen {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-ink);
    min-width: 2.75rem;
    text-align: right;
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
  }

  /* ── Mode Mobile (< 640px) ── */
  @media (max-width: 639px) {
    .demografi-capsule {
      flex-direction: column;
      align-items: stretch;
      max-width: 22rem;
      background: #ffffff;
      border-radius: 1.5rem;
      padding: 1.5rem 1.125rem;
      gap: 1.25rem;
    }
    .demografi-head {
      width: auto;
      height: auto;
      justify-content: center;
    }
    .demografi-head-bg {
      display: none;
    }
    .demografi-donut-wrap {
      width: 10rem;
      height: 10rem;
      margin-right: 0;
    }
    .demografi-angka {
      font-size: 1.75rem;
    }
    .demografi-body {
      background: transparent;
      border-radius: 0;
      margin-left: 0;
      min-height: auto;
      padding: 0;
      width: 100%;
    }
    .demografi-daftar {
      gap: 0.875rem;
    }
    .demografi-row {
      gap: 0.75rem;
    }
    .demografi-nama-wrap {
      min-width: 5.5rem;
      gap: 0.5rem;
    }
    .demografi-dot {
      width: 0.625rem;
      height: 0.625rem;
    }
    .demografi-nama {
      font-size: 0.8125rem;
    }
    .demografi-track {
      height: 0.5rem;
    }
    .demografi-persen {
      font-size: 0.8125rem;
      min-width: 2.25rem;
    }
  }
</style>
