---
// Hamburger menu untuk layar di bawah 1280px.
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';
import { url } from '../../lib/url';

interface Props {
  menu: { label: string; href: string }[];
  tautanKontak: string;
}

const { menu, tautanKontak } = Astro.props;
---

<button
  type="button"
  aria-controls="menu-hp"
  aria-expanded="false"
  aria-label="Buka menu"
  data-menu-tombol
  class="grid size-10 place-items-center rounded-full text-ink transition-colors hover:bg-sage-100 group-data-atas:text-white group-data-atas:hover:bg-white/15 sm:size-11 xl:hidden"
>
  <Icon name="menu" class="size-6" data-ikon-buka />
  <Icon name="x" class="hidden size-6" data-ikon-tutup />
</button>

<div id="menu-hp" hidden data-menu-panel class="absolute inset-x-0 top-full mt-2 rounded-2xl bg-white p-3 shadow-float xl:hidden">
  <nav aria-label="Menu utama">
    <ul class="flex flex-col">
      {
        menu.map((item) => (
          <li>
            <a href={url(item.href)} class="flex h-12 items-center rounded-xl px-4 text-base font-semibold text-ink hover:bg-sage-100">
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <Button href={tautanKontak} class="mt-2 w-full">Hubungi Kami</Button>
</div>

<script>
  const tombol = document.querySelector<HTMLButtonElement>('[data-menu-tombol]');
  const panel = document.querySelector<HTMLElement>('[data-menu-panel]');
  const kurangiGerakan = window.matchMedia('(prefers-reduced-motion: reduce)');
  let menuBuka = false;
  let animasi: Animation | undefined;

  function aturMenu(buka: boolean, kembalikanFokus = false, langsung = false) {
    if (!tombol || !panel) return;
    if (kembalikanFokus) tombol.focus();
    if (buka === menuBuka && !langsung) return;
    const gayaSaatIni = getComputedStyle(panel);
    const dari = panel.hidden ? { opacity: '0', transform: 'translateY(-8px) scale(0.985)' }
      : { opacity: gayaSaatIni.opacity, transform: gayaSaatIni.transform };
    animasi?.cancel();
    animasi = undefined;
    menuBuka = buka;
    // Saat menutup, tautan langsung dikeluarkan dari urutan fokus.
    panel.inert = !buka;
    tombol.setAttribute('aria-expanded', String(buka));
    tombol.setAttribute('aria-label', buka ? 'Tutup menu' : 'Buka menu');
    tombol.querySelector('[data-ikon-buka]')?.classList.toggle('hidden', buka);
    tombol.querySelector('[data-ikon-tutup]')?.classList.toggle('hidden', !buka);
    if (langsung || kurangiGerakan.matches || !panel.animate) {
      panel.hidden = !buka;
      return;
    }
    panel.hidden = false;
    animasi = panel.animate(
      [dari, { opacity: buka ? '1' : '0', transform: buka ? 'none' : 'translateY(-8px) scale(0.985)' }],
      { duration: buka ? 420 : 280, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
    );
    animasi.onfinish = () => {
      panel.hidden = !menuBuka;
      animasi = undefined;
    };
  }

  tombol?.addEventListener('click', () => aturMenu(!menuBuka));
  // Menu tertutup otomatis setelah salah satu tautan dipilih, atau saat tombol Escape ditekan.
  panel?.querySelectorAll('a').forEach((tautan) => tautan.addEventListener('click', () => aturMenu(false)));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menuBuka) aturMenu(false, true);
  });
  document.addEventListener('click', (event) => {
    if (event.target instanceof Node && !panel?.contains(event.target) && !tombol?.contains(event.target)) aturMenu(false);
  });
  window.matchMedia('(min-width: 1280px)').addEventListener('change', (event) => {
    if (event.matches) {
      const fokusDiMenu = panel?.contains(document.activeElement);
      aturMenu(false, false, true);
      if (fokusDiMenu) document.querySelector<HTMLElement>('[data-header] [data-logo]')?.focus({ preventScroll: true });
    }
  });
  kurangiGerakan.addEventListener('change', () => aturMenu(menuBuka, false, true));
</script>
