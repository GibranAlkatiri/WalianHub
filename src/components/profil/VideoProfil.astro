---
// Section Video Profil pada halaman Profil: video pengenalan/potensi kelurahan di kiri, judul dan deskripsi singkat di kanan.
// URL YouTube ditempel (watch, youtu.be, atau embed) lalu diubah ke embed saat tampil. Kosong: kartu placeholder.
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Icon from "../ui/Icon.astro";

export interface VideoProfilData {
  url: string;
  judul: string;
  deskripsi: string;
}

interface Props {
  videoProfil?: VideoProfilData;
  runtimeTemplate?: boolean;
}

const {
  videoProfil = { url: "", judul: "", deskripsi: "" },
  runtimeTemplate = false,
} = Astro.props;

/** Terima link YouTube apa pun (watch?v=, youtu.be/, /embed/, /shorts/), kembalikan URL embed. Di luar itu: null. */
function keEmbed(tautan: string): string | null {
  const bersih = tautan.trim();
  if (!bersih) return null;
  let id: string | null = null;
  try {
    const alamat = new URL(bersih, "https://www.youtube.com");
    if (alamat.hostname.includes("youtu.be"))
      id = alamat.pathname.slice(1).split("/")[0] || null;
    else if (alamat.pathname.startsWith("/embed/"))
      id = alamat.pathname.split("/")[2]?.split(/[?#]/)[0] || null;
    else if (alamat.pathname.startsWith("/shorts/"))
      id = alamat.pathname.split("/")[2]?.split(/[?#]/)[0] || null;
    else id = alamat.searchParams.get("v");
  } catch {
    return null;
  }
  if (!id || !/^[\w-]{6,}$/.test(id)) return null;
  return `https://www.youtube.com/embed/${id}`;
}

const embed = runtimeTemplate
  ? "__CMS_VIDEO_EMBED__"
  : keEmbed(videoProfil.url);
const judulTampil = videoProfil.judul.trim() || "Potensi Kelurahan Walian";
---

<section id="video-profil" class="bg-forest-900 py-12 sm:py-16 lg:py-24">
  <Container>
    <SectionHeading overline="Video Profil" title="Mengenal Kelurahan Walian" class="text-white [&>h2]:text-white [&>p]:text-white/70 [&_p:first-child]:text-sun-400" />
    <div class="mt-8 grid items-start gap-8 lg:mt-12 lg:grid-cols-2 lg:gap-12">
      <div data-motion="content">
        {
          runtimeTemplate ? (
            <div class="aspect-video overflow-hidden rounded-2xl bg-ink shadow-card">
              __CMS_VIDEO_FRAME__
            </div>
          ) : embed ? (
            <div class="aspect-video overflow-hidden rounded-2xl bg-ink shadow-card">
              <iframe
                src={embed}
                title={judulTampil}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
                class="h-full w-full"
              />
            </div>
          ) : (
            <div class="grid aspect-video place-items-center rounded-2xl bg-sage-100 text-center shadow-card">
              <div class="px-6">
                <span class="mx-auto grid size-12 place-items-center rounded-full bg-white text-forest-600">
                  <Icon name="play" class="size-5" />
                </span>
                <p class="mt-3 font-semibold text-ink">Video menyusul</p>
                <p class="mt-1 text-sm text-ink-muted">
                  Tautan video YouTube belum diisi melalui CMS.
                </p>
              </div>
            </div>
          )
        }
      </div>
      <div data-motion="content">
        <h3
          class="text-xl leading-snug font-bold text-balance text-white sm:text-2xl"
        >
          {runtimeTemplate ? "__CMS_VIDEO_TITLE__" : judulTampil}
        </h3>
        {
          runtimeTemplate ? (
            <p class="mt-3 text-white/70">__CMS_VIDEO_DESCRIPTION__</p>
          ) : videoProfil.deskripsi.trim() ? (
            <p class="mt-3 text-white/70">{videoProfil.deskripsi}</p>
          ) : (
            <p class="mt-3 text-white/50">
              Deskripsi singkat video belum diisi melalui CMS.
            </p>
          )
        }
      </div>
    </div>
  </Container>
</section>
