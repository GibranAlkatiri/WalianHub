---
// Penyajian frontend untuk total wilayah dan demografi agama dari data Profil.
// Marker runtime memakai total yang sudah dihitung oleh publikasi CMS.
import type { CollectionEntry } from 'astro:content';
import Container from '../ui/Container.astro';
import StatCard from '../ui/StatCard.astro';
import { formatAngka } from '../../lib/format';

type Profil = CollectionEntry<'profil'>['data'];
type Beranda = CollectionEntry<'beranda'>['data'];
interface Props {
  lingkungan: Profil['lingkungan'];
  jumlahPenduduk?: number | null;
  demografiAgama?: Beranda['demografiAgama'];
  runtimeTemplate?: boolean;
}
const { lingkungan, jumlahPenduduk = null, demografiAgama: mentahAgama = { kristen: 0, katolik: 0, islam: 0, hindu: 0, buddha: 0, konghucu: 0 }, runtimeTemplate = false } = Astro.props;

// Normalisasi object 6 agama (+fallback array lama) ke daftar tampilan.
const labelAgama: Record<string, string> = {
  kristen: 'Kristen',
  katolik: 'Katolik',
  islam: 'Islam',
  hindu: 'Hindu',
  buddha: 'Buddha',
  konghucu: 'Konghucu',
};
const demografiAgama = Array.isArray(mentahAgama)
  ? mentahAgama
  : Object.entries(mentahAgama ?? {}).map(([kunci, jumlah]) => ({ agama: labelAgama[kunci] ?? kunci, jumlah: jumlah || 0 }));

const jumlahkan = (key: 'kepalaKeluarga' | 'jumlahPenduduk' | 'luasKm2') => {
  const terisi = lingkungan.map(item => item[key]).filter((angka): angka is number => angka != null);
  return terisi.length ? terisi.reduce((a, b) => a + b, 0) : null;
};

// Hitung total penduduk dan persentase agama
const totalPendudukLingkungan = jumlahkan('jumlahPenduduk');
const totalJiwaAgama = demografiAgama.reduce((acc, item) => acc + (item.jumlah || 0), 0);
const totalPenduduk = jumlahPenduduk ?? totalPendudukLingkungan ?? (totalJiwaAgama > 0 ? totalJiwaAgama : null);

const WARNA_AGAMA: Record<string, string> = {
  'Kristen': '#2563eb',
  'Kristen Protestan': '#2563eb',
  'Katolik': '#7c3aed',
  'Islam': '#059669',
  'Hindu': '#d97706',
  'Buddha': '#db2777',
  'Konghucu': '#dc2626',
};
const WARNA_CADANGAN = ['#2563eb', '#7c3aed', '#059669', '#d97706', '#db2777', '#dc2626', '#0891b2', '#4f46e5'];

const WARNA_LAINNYA = '#94a3b8';
// ponytail: warna netral tetap; ganti ke token palette saat token abu resmi tersedia.

const radius = 38;
const keliling = 2 * Math.PI * radius; // ~238.76

const basisTotal = totalJiwaAgama > 0 ? totalJiwaAgama : 1;

// Urutkan menurun, ambil 3 teratas, gabung sisanya jadi "Lainnya".
const terurut = [...demografiAgama].sort((a, b) => (b.jumlah || 0) - (a.jumlah || 0));
const tigaTeratas = terurut.slice(0, 3);
const sisa = terurut.slice(3);
const tampilanAgama =
  sisa.length > 0
    ? [...tigaTeratas, { agama: 'Lainnya', jumlah: sisa.reduce((acc, item) => acc + (item.jumlah || 0), 0) }]
    : tigaTeratas;
let offsetBerjalan = 0;

const dataAgama = tampilanAgama.map((item, index) => {
  const persen = totalJiwaAgama > 0 ? (item.jumlah / basisTotal) * 100 : 0;
  const panjangBusur = (persen / 100) * keliling;
  const offset = offsetBerjalan;
  if (persen > 0) {
    offsetBerjalan += panjangBusur;
  }
  const warna = item.agama === 'Lainnya' ? WARNA_LAINNYA : (WARNA_AGAMA[item.agama] || WARNA_CADANGAN[index % WARNA_CADANGAN.length]);
  return {
    ...item,
    persen,
    persenLabel: persen >= 10 ? persen.toFixed(1).replace(/\.0$/, '') : (persen > 0 ? persen.toFixed(1) : '0'),
    panjangBusur,
    offset,
    warna,
  };
});
---

<section id="ringkasan-kelurahan" aria-label="Ringkasan kelurahan" class="village-summary">
  <Container>
    <!-- Ringkasan Lingkungan dan Luas Wilayah (2 stat saja) -->
    <div class="village-summary-content">
      <div class="village-summary-stats">
        {runtimeTemplate ? '__CMS_STATS__' : <>
          <StatCard ikon="map" label="Lingkungan" angka={lingkungan.length ? String(lingkungan.length) : null} />
          <StatCard ikon="land-plot" label="Luas wilayah" angka={formatAngka(jumlahkan('luasKm2'))} satuan="km²" />
        </>}
      </div>
    </div>

    <!-- Demografi Agama: donut tanpa bingkai + daftar menyatu -->
    {runtimeTemplate ? '__CMS_DEMOGRAFI__' : dataAgama.length > 0 && (
      <div class="demografi-card">
        <!-- Donut chart tanpa bingkai -->
        <div class="demografi-donut-wrap" aria-label={`Total penduduk: ${formatAngka(totalPenduduk) ?? '–'} jiwa`}>
          <svg class="demografi-donut-svg" viewBox="0 0 100 100" aria-hidden="true">
            <circle
              cx="50"
              cy="50"
              r={radius}
              fill="none"
              stroke="rgb(226 232 240 / 0.8)"
              stroke-width="9"
            />
            {dataAgama.map((item) => item.persen > 0 && (
              <circle
                cx="50"
                cy="50"
                r={radius}
                fill="none"
                stroke={item.warna}
                stroke-width="9"
                stroke-dasharray={`${item.panjangBusur} ${keliling - item.panjangBusur}`}
                stroke-dashoffset={-item.offset}
                transform="rotate(-90 50 50)"
                class="demografi-slice"
              />
            ))}
          </svg>

          <div class="demografi-pusat">
            <span class="demografi-angka">{formatAngka(totalPenduduk) ?? '–'}</span>
            <span class="demografi-satuan">Jiwa</span>
            <span class="demografi-label">Jumlah Penduduk</span>
          </div>
        </div>

        <!-- Daftar agama vertikal menyatu dengan donut -->
        <div class="demografi-daftar-wrap">
          <div class="demografi-daftar">
            {dataAgama.map((item) => (
              <div class="demografi-item">
                <div class="demografi-baris-teks">
                  <span class="demografi-nama-agama">
                    <span class="demografi-dot" style={`background-color: ${item.warna};`}></span>
                    <span class="demografi-nama">{item.agama}</span>
                  </span>
                  <span class="demografi-nilai">
                    <strong class="demografi-persen">{item.persenLabel}%</strong>
                  </span>
                </div>
                <div class="demografi-garis-track">
                  <div
                    class="demografi-garis-isi"
                    style={`width: ${Math.max(item.persen, item.jumlah > 0 ? 2 : 0)}%; background-color: ${item.warna};`}
                  ></div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    )}
  </Container>
</section>

<style>
  .village-summary {
    position: relative;
    padding-bottom: 1.5rem;
  }
  .village-summary-content {
    padding: 1.25rem;
    border: 1px solid rgb(255 255 255 / 0.8);
    border-radius: 1.5rem;
    background: var(--color-cream-50);
    box-shadow: 0 12px 32px rgb(31 51 22 / 0.12);
  }
  .village-summary-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 1rem;
  }
  .village-summary-stats :global([data-stat-card]) {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    column-gap: 0.625rem;
    background: transparent;
    border-radius: 0;
    padding: 0;
    box-shadow: none;
  }
  .village-summary-stats :global([data-stat-card] > span) {
    grid-row: 1 / 3;
    width: 2rem;
    height: 2rem;
  }
  .village-summary-stats :global([data-stat-value]) {
    margin: 0;
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    line-height: 1.3;
    font-variant-numeric: tabular-nums;
  }
  .village-summary-stats :global([data-stat-empty]) {
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .village-summary-stats :global([data-stat-unit]) { font-size: 0.6875rem; }
  .village-summary-stats :global([data-stat-label]) {
    font-size: 0.75rem;
    line-height: 1.3;
    color: var(--color-ink-muted);
  }
  @media (min-width: 640px) {
    .village-summary-stats :global([data-stat-card] + [data-stat-card]) {
      border-left: 1px solid var(--color-line);
      padding-left: 1rem;
    }
  }
  @media (min-width: 1024px) {
    .village-summary-content { padding: 1.5rem; }
    .village-summary-stats :global([data-stat-card]) { column-gap: 0.875rem; }
    .village-summary-stats :global([data-stat-card] > span) { width: 2.5rem; height: 2.5rem; }
    .village-summary-stats :global([data-stat-card] + [data-stat-card]) { padding-left: 1.5rem; }
    .village-summary-stats :global([data-stat-label]) { font-size: 0.8125rem; }
  }

  /* ── Demografi Card: donut compact + daftar menyatu ── */
  .demografi-card {
    display: flex;
    align-items: center;
    max-width: 26rem;
    margin: 1rem auto 0;
    position: relative;
  }

  .demografi-donut-wrap {
    position: relative;
    width: 6.5rem;
    height: 6.5rem;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
  }

  .demografi-donut-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 1px 3px rgb(0 0 0 / 0.04));
  }

  .demografi-slice {
    transition: stroke-dashoffset 0.6s ease, stroke-dasharray 0.6s ease;
  }

  .demografi-pusat {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    pointer-events: none;
    z-index: 1;
    padding: 0.125rem;
  }

  .demografi-angka {
    font-size: clamp(0.8125rem, 1.5vw, 1rem);
    font-weight: 800;
    line-height: 1.1;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }

  .demografi-satuan {
    font-size: 0.5rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-forest-700);
    margin-top: 0.0625rem;
  }

  .demografi-label {
    font-size: 0.4375rem;
    color: var(--color-ink-muted);
    margin-top: 0.0625rem;
    line-height: 1.2;
  }

  .demografi-daftar-wrap {
    flex: 1;
    min-width: 0;
    padding: 0.625rem 0.875rem 0.625rem 2rem;
    margin-left: -1rem;
    border: 1px solid rgb(255 255 255 / 0.8);
    border-radius: 0 0.75rem 0.75rem 0;
    background: var(--color-cream-50);
    box-shadow: 0 6px 18px rgb(31 51 22 / 0.08);
  }

  .demografi-daftar {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.4rem;
  }

  .demografi-item {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .demografi-baris-teks {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.375rem;
    font-size: 0.6875rem;
  }

  .demografi-nama-agama {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .demografi-dot {
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: 9999px;
    flex-shrink: 0;
  }

  .demografi-nilai {
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
    font-variant-numeric: tabular-nums;
  }

  .demografi-persen {
    font-weight: 700;
    color: var(--color-ink);
  }

  .demografi-garis-track {
    width: 100%;
    height: 0.1875rem;
    background: rgb(0 0 0 / 0.06);
    border-radius: 9999px;
    overflow: hidden;
  }

  .demografi-garis-isi {
    height: 100%;
    border-radius: 9999px;
    transition: width 0.5s ease;
  }

  @media (max-width: 639px) {
    .demografi-card {
      flex-direction: column;
      align-items: center;
      max-width: 18rem;
    }
    .demografi-donut-wrap {
      width: 5.5rem;
      height: 5.5rem;
      margin-bottom: -0.75rem;
      z-index: 2;
    }
    .demografi-daftar-wrap {
      margin-left: 0;
      margin-top: 0;
      padding: 1.25rem 0.75rem 0.75rem;
      border-radius: 0 0 0.75rem 0.75rem;
      width: 100%;
    }
  }
</style>
