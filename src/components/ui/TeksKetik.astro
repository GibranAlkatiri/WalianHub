---
import { JEDA_HURUF_JUDUL } from '../../lib/teks-ketik';

interface Props {
  teks: string;
  jedaAwal?: number;
  jedaHuruf?: number;
}

const { teks, jedaAwal = 0, jedaHuruf = JEDA_HURUF_JUDUL } = Astro.props;
const pemisah = new Intl.Segmenter('id', { granularity: 'grapheme' });
let urutan = 0;
// Kata tetap utuh saat membungkus baris; semua huruf sudah menempati ruangnya.
const bagian = teks.split(/(\s+)/).filter(Boolean).map((kata) => ({
  teks: kata,
  spasi: /^\s+$/.test(kata),
  huruf: Array.from(pemisah.segment(kata), ({ segment }) => ({
    teks: segment,
    jeda: jedaAwal + urutan++ * jedaHuruf,
  })),
}));
---

{/* Pembaca layar membaca kalimat lengkap sekali, bukan huruf demi huruf. */}
<span class="sr-only">{teks}</span>
<span aria-hidden="true">
  {bagian.map((kata) => kata.spasi ? kata.teks : (
    <span class="inline-block max-w-full">
      {kata.huruf.map((huruf) => (
        <span class="hero-huruf" style={`--jeda-huruf: ${huruf.jeda}ms`}>{huruf.teks}</span>
      ))}
    </span>
  ))}
</span>
