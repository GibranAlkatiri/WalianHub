---
// Video mendampingi pengantar Profil; tanpa tautan yang dapat diputar, blok tidak dirender.
import { videoProfilEmbed, type VideoProfilData } from '../../lib/video-profil';

interface Props {
  videoProfil?: VideoProfilData;
  runtimeTemplate?: boolean;
}
const { videoProfil, runtimeTemplate = false } = Astro.props;
const embed = videoProfilEmbed(videoProfil?.url);
const judul = videoProfil?.judul.trim() || 'Video pengenalan Kelurahan Walian';
const deskripsi = videoProfil?.deskripsi.trim();
---

{(runtimeTemplate || embed) && (
  <aside id="video-profil" aria-labelledby="judul-video-profil" class="min-w-0">
    <div class="aspect-video overflow-hidden rounded-2xl bg-ink shadow-card">
      {runtimeTemplate ? '__CMS_VIDEO_FRAME__' : (
        <iframe src={embed!} title={judul} loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen class="h-full w-full" />
      )}
    </div>
    <h2 id="judul-video-profil" class="mt-4 text-lg font-bold text-ink">{runtimeTemplate ? '__CMS_VIDEO_TITLE__' : judul}</h2>
    {runtimeTemplate ? '__CMS_VIDEO_DESCRIPTION_BLOCK__' : deskripsi && <p class="mt-2 text-sm text-ink-muted">{deskripsi}</p>}
  </aside>
)}
