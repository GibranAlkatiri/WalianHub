---
interface Props { label: string; jumlah: string; persen: string; lebar: string; }
const { label, jumlah, persen, lebar } = Astro.props;
---
<li class="grid grid-cols-[minmax(0,1fr)_auto] gap-x-4 gap-y-2">
  <span class="font-semibold text-ink">{label}</span>
  <span class="text-right text-sm tabular-nums text-ink-muted">{jumlah} jiwa <span class="ml-2 text-forest-700">{persen}%</span></span>
  <div aria-hidden="true" class="col-span-2 h-2 overflow-hidden rounded-full bg-sage-100"><div class="h-full rounded-full bg-forest-600" style={`width: ${lebar}%`}></div></div>
</li>
