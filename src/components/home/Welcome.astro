---
// Section 3 Beranda: Sambutan Lurah.
// Foto berbingkai dengan dua badge bulat di kiri, teks di kanan.
import type { CollectionEntry } from 'astro:content';
import Container from '../ui/Container.astro';
import SmartImage from '../ui/SmartImage.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { url } from '../../lib/url';
import { tujuan } from '../../lib/navigasi';

interface Props {
  sambutan: CollectionEntry<'beranda'>['data']['sambutan'];
}

const { sambutan } = Astro.props;
---

<section id="sambutan" class="py-12 sm:py-16 lg:pt-28 lg:pb-24">
  <Container class="grid items-center gap-12 sm:gap-14 lg:grid-cols-2 lg:gap-20">
    <div class="relative isolate mx-auto w-full max-w-md lg:max-w-none">
      <div aria-hidden="true" class="absolute -inset-6 -z-10 rounded-full bg-sun-100 blur-3xl"></div>
      <div class="rounded-lg bg-white p-2 shadow-float lg:p-3">
        <SmartImage src={sambutan.foto} alt={`${sambutan.nama}, ${sambutan.jabatan}`} class="aspect-[4/3] rounded-md" />
      </div>
      <span
        aria-hidden="true"
        class="absolute -top-6 -left-2 grid size-16 place-items-center rounded-full bg-forest-600 text-white shadow-float ring-4 ring-cream-50 sm:-top-7 sm:-left-3 sm:size-20 lg:-top-9 lg:-left-9 lg:size-24"
      >
        <Icon name="landmark" class="size-7 sm:size-9 lg:size-10" />
      </span>
      <span
        aria-hidden="true"
        class="absolute -right-3 -bottom-5 grid size-11 place-items-center rounded-full bg-sun-400 text-forest-900 shadow-float ring-4 ring-cream-50 sm:size-12 lg:size-14"
      >
        <Icon name="leaf" class="size-6" />
      </span>
    </div>

    <div>
      <p class="text-sm font-semibold tracking-widest text-forest-600 uppercase">Sambutan Lurah</p>
      <h2 class="mt-2 text-2xl leading-tight font-bold text-balance text-ink sm:text-3xl lg:text-4xl">{sambutan.judul}</h2>
      <blockquote class="mt-4 border-l-4 border-sage-300 pl-4 text-base text-ink-muted sm:mt-5 sm:pl-5 sm:text-lg">
        <p>{sambutan.isi}</p>
      </blockquote>
      <p class="mt-6 font-bold text-ink">{sambutan.nama}</p>
      <p class="text-base text-ink-subtle">{sambutan.jabatan}</p>
      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
        <Button href={tujuan('/profil', 'profil')}>Profil Kelurahan</Button>
        <a
          href={url(tujuan('/profil#pemerintahan', 'profil'))}
          class="inline-flex items-center gap-1 text-base font-semibold text-forest-600 underline-offset-4 hover:underline"
        >
          Struktur Organisasi
          <Icon name="arrow-right" class="size-4" />
        </a>
      </div>
    </div>
  </Container>
</section>
