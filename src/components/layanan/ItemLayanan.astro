---
// Satu layanan di halaman Layanan. Nama dan ringkasan selalu terlihat; persyaratan, alur, dan catatan
// muncul saat ditekan. Memakai <details> dengan name yang sama, jadi hanya satu layanan terbuka dalam satu waktu:
// membuka layanan baru menutup yang sebelumnya. Browser yang mengatur ini, jadi tetap berfungsi tanpa skrip.
// Anchor layanan memakai nama filenya, contoh /layanan#surat-keterangan-domisili. Layanan yang dibuka lewat anchor langsung terbuka.
import { render, type CollectionEntry } from 'astro:content';
import Icon from '../ui/Icon.astro';

interface Props {
  layanan: CollectionEntry<'layanan'>;
}

const { layanan } = Astro.props;
const { judul, ringkasan, ikon, persyaratan, alur } = layanan.data;
const { Content } = await render(layanan);
const adaCatatan = Boolean(layanan.body?.trim());
---

<details id={layanan.id} name="layanan" class="group rounded-2xl bg-white shadow-card target:ring-2 target:ring-forest-600">
  <summary class="flex cursor-pointer list-none items-center gap-4 rounded-2xl p-4 sm:p-5 [&::-webkit-details-marker]:hidden">
    <span class="grid size-11 shrink-0 place-items-center rounded-full bg-sage-100 text-forest-600"><Icon name={ikon} /></span>
    <span class="min-w-0 flex-1">
      <h3 class="font-bold text-ink">{judul}</h3>
      <span class="mt-0.5 block text-sm text-ink-muted">{ringkasan}</span>
    </span>
    <Icon name="chevron-down" class="size-5 shrink-0 text-forest-600 transition-transform group-open:rotate-180 motion-reduce:transition-none" />
  </summary>

  <div class="border-t border-line p-4 sm:p-5 lg:px-20">
    <div class="grid gap-6 md:grid-cols-2">
      <div>
        <h4 class="text-sm font-semibold tracking-widest text-forest-600 uppercase">Persyaratan</h4>
        <ul class="mt-2 list-disc space-y-1 pl-5 text-ink-muted marker:text-forest-600">
          {persyaratan.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div>
        <h4 class="text-sm font-semibold tracking-widest text-forest-600 uppercase">Alur pengurusan</h4>
        <ol class="mt-2 list-decimal space-y-1 pl-5 text-ink-muted marker:font-semibold marker:text-forest-600">
          {alur.map((item) => <li>{item}</li>)}
        </ol>
      </div>
    </div>

    {
      adaCatatan && (
        <div class="mt-6 space-y-2 text-ink-muted [&_a]:font-semibold [&_a]:text-forest-600 [&_a]:underline [&_a]:underline-offset-4">
          <Content />
        </div>
      )
    }
  </div>
</details>

<script>
  // Layanan yang dibuka lewat anchor (misalnya dari card layanan di Beranda) langsung terbuka.
  function bukaDariAnchor() {
    const id = decodeURIComponent(location.hash.slice(1));
    const layanan = id ? document.getElementById(id) : null;
    if (layanan instanceof HTMLDetailsElement) layanan.open = true;
  }
  bukaDariAnchor();
  window.addEventListener('hashchange', bukaDariAnchor);
</script>
