---
// Tombol ganti bahasa ID/EN.
// Tahap 1: EN sudah tampil tetapi belum aktif. Fungsi terjemahan otomatis menyusul di Tahap 2.
---

<div role="group" aria-label="Pilih bahasa" class="inline-flex h-9 items-center rounded-full bg-sage-100 p-1 text-sm font-semibold sm:h-11">
  <button type="button" aria-pressed="true" class="h-7 rounded-full bg-forest-600 px-2.5 text-white sm:h-9 sm:px-3">ID</button>
  <button
    type="button"
    aria-disabled="true"
    title="Versi bahasa Inggris segera hadir"
    class="h-7 cursor-not-allowed rounded-full px-2.5 text-ink-muted sm:h-9 sm:px-3"
  >
    EN
  </button>
</div>
