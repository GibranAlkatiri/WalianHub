---
// Section 1 Beranda: foto selebar layar sebagai latar, dengan judul di atasnya.
// Header melayang di atas foto. Judul dan subjudul putih berada di tengah foto, dan muncul bertahap saat halaman dibuka.
// Warna foto diredam dan diberi lapisan hijau agar menyatu dengan website, lalu bagian bawahnya melebur ke latar halaman.
// Lebih dari satu foto: berganti otomatis dengan efek memudar dan zoom pelan, disertai tombol jeda.
// Pengunjung yang mematikan animasi di perangkatnya: tanpa animasi, dan foto tidak berganti sendiri.
import type { CollectionEntry } from 'astro:content';
import Container from '../ui/Container.astro';
import SmartImage from '../ui/SmartImage.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  hero: CollectionEntry<'beranda'>['data']['hero'];
}

const { hero } = Astro.props;
const daftarFoto = hero.foto.filter((foto) => foto.gambar.trim());
const tanpaFoto = daftarFoto.length === 0;
const bergilir = daftarFoto.length > 1;

// Bagian foto yang tetap terlihat saat foto terpotong di layar sempit.
const posisiFoto = {
  kiri: '[&_img]:object-left',
  tengah: '[&_img]:object-center',
  kanan: '[&_img]:object-right',
} as const;
---

<section
  aria-labelledby="judul-hero"
  data-hero-slideshow={bergilir ? '' : undefined}
  class="relative isolate flex min-h-[460px] items-center overflow-hidden sm:min-h-[500px] lg:min-h-[min(600px,80vh)]"
>
  {/* Latar: foto (atau gambar default), lapisan hijau, lalu gradasi atas dan bawah. Latar hijau tua mencegah kilatan terang saat foto berganti. */}
  <div class="absolute inset-0 -z-10 bg-forest-900">
    {
      tanpaFoto ? (
        <SmartImage src="" alt="Pemandangan Kelurahan Walian" fill priority showLabel={false} />
      ) : (
        daftarFoto.map((foto, i) => (
          <div
            data-slide
            data-aktif={i === 0 ? '' : undefined}
            aria-hidden={i === 0 ? undefined : 'true'}
            class="absolute inset-0 opacity-0 saturate-60 transition-opacity duration-1000 data-aktif:opacity-100 motion-safe:data-aktif:animate-hero-zoom"
          >
            <SmartImage src={foto.gambar} alt={foto.keterangan} fill priority={i === 0} showLabel={false} class={posisiFoto[foto.posisi]} />
          </div>
        ))
      )
    }
    {/* Lapisan hijau rata di seluruh foto, agar warnanya menyatu dengan website dan teks putih di tengah tetap terbaca */}
    <div aria-hidden="true" class="absolute inset-0 bg-forest-900/70"></div>
    {/* Gradasi gelap tambahan di atas, supaya menu navbar putih tetap terbaca di atas foto terang */}
    <div aria-hidden="true" class="absolute inset-x-0 top-0 h-40 bg-linear-to-b from-forest-900/60 to-transparent"></div>
    {/* Gradasi bawah: foto melebur ke warna latar halaman sebelum section berikutnya */}
    <div aria-hidden="true" class="absolute inset-x-0 bottom-0 h-24 bg-linear-to-b from-cream-50/0 to-cream-50 lg:h-32"></div>
  </div>

  <Container class="py-28 text-center lg:py-32">
    <h1
      id="judul-hero"
      class="mx-auto max-w-2xl text-3xl leading-[1.1] font-extrabold text-balance text-white motion-safe:animate-hero-muncul-1 sm:text-4xl lg:text-6xl"
    >
      {hero.judul}
    </h1>
    <p class="mx-auto mt-4 max-w-xl text-base text-pretty text-white/90 motion-safe:animate-hero-muncul-2 sm:mt-5 sm:text-lg lg:text-xl">
      {hero.subjudul}
    </p>
  </Container>

  {/* Pojok kanan bawah: label gambar default, atau tombol jeda jika fotonya lebih dari satu. Keterangan foto tidak ditampilkan. */}
  <div class="absolute inset-x-0 bottom-16 lg:bottom-20">
    <Container class="flex items-center justify-end gap-2">
      {tanpaFoto && <span class="rounded-full bg-ink/80 px-3 py-1 text-sm font-semibold text-white">Foto belum tersedia</span>}
      {
        bergilir && (
          <button
            type="button"
            data-hero-jeda
            aria-label="Jeda pergantian foto"
            class="group/jeda grid size-10 shrink-0 place-items-center rounded-full bg-ink/80 text-white transition-colors hover:bg-ink focus-visible:outline-sun-400"
          >
            <Icon name="pause" class="size-4 group-data-[berhenti]/jeda:hidden" />
            <Icon name="play" class="hidden size-4 group-data-[berhenti]/jeda:block" />
          </button>
        )
      }
    </Container>
  </div>
</section>

<script>
  // Pergantian foto hero. Skrip hanya mengubah atribut data dan aria;
  // tampilannya diatur oleh kelas yang sudah tertulis di markup.
  const JEDA_MS = 5000;

  const hero = document.querySelector<HTMLElement>('[data-hero-slideshow]');

  if (hero) {
    const daftarSlide = hero.querySelectorAll<HTMLElement>('[data-slide]');
    const tombol = hero.querySelector<HTMLButtonElement>('[data-hero-jeda]')!;
    let aktif = 0;
    let timer: ReturnType<typeof setInterval> | undefined;
    // Pengunjung yang mematikan animasi: foto tidak berganti sendiri, tetapi tetap bisa diputar lewat tombol.
    let berhenti = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function tandai(nomor: number, nyala: boolean) {
      daftarSlide[nomor].toggleAttribute('data-aktif', nyala);
      if (nyala) daftarSlide[nomor].removeAttribute('aria-hidden');
      else daftarSlide[nomor].setAttribute('aria-hidden', 'true');
    }

    function tampilkan(nomor: number) {
      tandai(aktif, false);
      aktif = nomor;
      tandai(aktif, true);
    }

    // Timer hanya berjalan jika tidak dijeda dan tab sedang dilihat.
    function aturTimer() {
      clearInterval(timer);
      timer = undefined;
      if (!berhenti && !document.hidden) {
        timer = setInterval(() => tampilkan((aktif + 1) % daftarSlide.length), JEDA_MS);
      }
    }

    function perbaruiTombol() {
      tombol.toggleAttribute('data-berhenti', berhenti);
      tombol.setAttribute('aria-label', berhenti ? 'Putar pergantian foto' : 'Jeda pergantian foto');
    }

    tombol.addEventListener('click', () => {
      berhenti = !berhenti;
      perbaruiTombol();
      aturTimer();
    });
    document.addEventListener('visibilitychange', aturTimer);

    perbaruiTombol();
    aturTimer();
  }
</script>
