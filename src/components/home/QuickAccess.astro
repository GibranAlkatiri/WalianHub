---
// Section 2 Beranda: kotak status jam layanan yang menempel di batas bawah hero.
// Menampilkan status kantor langsung (buka, istirahat, atau tutup) menurut waktu WITA,
// dan menuju section Kontak yang berisi jadwal lengkap, peta, dan WhatsApp.
// Kotak ini sengaja hanya berisi status, karena pintasan lain sudah ada di menu dan section Kontak.
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';
import { url } from '../../lib/url';
import { tautanKontak } from '../../lib/navigasi';
import type { DataJamLayanan } from '../../lib/jam-layanan';

interface Props {
  jamLayanan: DataJamLayanan;
}

const { jamLayanan } = Astro.props;
---

<section aria-label="Status layanan kantor" class="relative z-10 -mt-9">
  <Container>
    <div class="mx-auto max-w-md rounded-full bg-sage-300 p-2.5 shadow-float sm:p-3">
      <a
        href={url(tautanKontak)}
        data-status-layanan={JSON.stringify(jamLayanan)}
        class="group/status flex items-center justify-center gap-3 rounded-full bg-white px-4 py-2.5 text-sm leading-tight font-semibold text-forest-900 transition-colors hover:bg-sage-100 lg:py-2 lg:text-base"
      >
        <span class="grid size-8 shrink-0 place-items-center rounded-full bg-sage-100 text-forest-600 lg:size-9">
          {/* Sebelum skrip berjalan: ikon jam. Setelah itu: lampu status. */}
          <Icon name="clock" class="size-4 group-data-[status]/status:hidden lg:size-5" />
          <span class="relative hidden size-3 group-data-[status]/status:block" aria-hidden="true">
            <span class="absolute inset-0 hidden animate-ping rounded-full bg-lampu-buka opacity-75 group-data-[status=buka]/status:block motion-reduce:animate-none" />
            <span class="relative block size-3 rounded-full group-data-[status=buka]/status:bg-lampu-buka group-data-[status=istirahat]/status:bg-lampu-istirahat group-data-[status=tutup]/status:bg-lampu-tutup" />
          </span>
        </span>
        <span>
          <span class="sr-only" data-status-pembaca />
          <span data-status-teks>Jam Layanan</span>
        </span>
      </a>
    </div>
  </Container>
</section>

<script>
  import { statusLayanan, type DataJamLayanan, type StatusLayanan } from '../../lib/jam-layanan';

  // Teks tambahan untuk pembaca layar, karena buka dan istirahat hanya dibedakan lewat warna lampu.
  // Status tutup sudah jelas dari tulisannya ("Kantor tutup"), jadi tidak perlu teks tambahan.
  const teksPembaca: Record<StatusLayanan, string> = {
    buka: 'Kantor sedang buka. ',
    istirahat: 'Kantor sedang istirahat, tetap bisa didatangi. ',
    tutup: '',
  };

  function perbarui() {
    document.querySelectorAll<HTMLElement>('[data-status-layanan]').forEach((el) => {
      const data: DataJamLayanan = JSON.parse(el.dataset.statusLayanan ?? '');
      const { status, teks } = statusLayanan(data, new Date());
      el.dataset.status = status;
      el.querySelector('[data-status-pembaca]')!.textContent = teksPembaca[status];
      el.querySelector('[data-status-teks]')!.textContent = teks;
    });
  }

  perbarui();
  setInterval(perbarui, 30_000);
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) perbarui();
  });
</script>
