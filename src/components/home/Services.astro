---
// Section 3 Beranda: layanan yang paling sering dicari. Anchor #layanan.
import { getCollection } from 'astro:content';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import ServiceCard from '../ui/ServiceCard.astro';
import Button from '../ui/Button.astro';

const semuaLayanan = await getCollection('layanan');
const layanan = semuaLayanan
  .filter((item) => item.data.unggulan)
  .sort((a, b) => a.data.urutan - b.data.urutan);
// Semua layanan yang dicentang tampil; layanan lainnya tersedia di daftar lengkap.
const adaLainnya = semuaLayanan.length > layanan.length;
---

<section id="layanan" class="bg-white py-12 sm:py-16 lg:py-24">
  <Container>
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <SectionHeading
        overline="Layanan"
        title="Layanan kelurahan"
        description="Persyaratan dan alur pengurusan surat yang paling sering dibutuhkan warga."
      />
      <div data-cms-all-services hidden={!adaLainnya} class="shrink-0">
        <Button href="/layanan" variant="outline">Semua Layanan</Button>
      </div>
    </div>

    <p data-cms-services-empty hidden={layanan.length > 0} class="mt-8 rounded-2xl bg-sage-100 p-6 text-ink-muted">{semuaLayanan.length === 0 ? 'Daftar layanan sedang disiapkan.' : 'Lihat daftar lengkap untuk informasi layanan kelurahan.'}</p>
    <div data-cms-service-cards hidden={layanan.length === 0} data-motion-group class="mt-8 grid gap-3 sm:mt-10 sm:grid-cols-2 sm:gap-4 lg:grid-cols-4 lg:gap-6">
      {
        layanan.map((item) => (
          <ServiceCard judul={item.data.judul} ringkasan={item.data.ringkasan} ikon={item.data.ikon} href={`/layanan#${item.id}`} motion="card" />
        ))
      }
    </div>
  </Container>
</section>
