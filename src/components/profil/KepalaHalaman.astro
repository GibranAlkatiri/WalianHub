---
// Kepala halaman Profil: breadcrumb, judul, ringkasan, dan tautan pil ke setiap section.
// Foto Lurah tampil di section Profil di Beranda, dan nama Lurah di kotak puncak bagan Struktur Organisasi.
import Container from '../ui/Container.astro';
import TeksKetik from '../ui/TeksKetik.astro';
import { url } from '../../lib/url';
import { JEDA_HURUF_SUBJUDUL, jedaSubjudulKetik } from '../../lib/teks-ketik';

interface Props {
  ringkasan: string;
  runtimeTemplate?: boolean;
}

const { ringkasan, runtimeTemplate = false } = Astro.props;
const judulHalaman = 'Profil Kelurahan Walian';

const tautanSection = [
  { label: 'Struktur Organisasi', anchor: '#struktur-organisasi' },
  { label: 'Wilayah', anchor: '#wilayah' },
  { label: 'Visi dan Misi', anchor: '#visi-misi' },
];
---

<section data-cms-profile-heading class="pt-8 pb-12 sm:pt-10 sm:pb-16 lg:pt-12 lg:pb-20">
  <Container>
    <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-sm text-ink-subtle">
      <a href={url('/')} class="hover:text-forest-600 hover:underline">Beranda</a>
      <span aria-hidden="true">/</span>
      <span class="text-ink">Profil</span>
    </nav>
    <h1 class="mt-4 text-3xl leading-tight font-extrabold text-balance text-ink sm:text-4xl">
      <TeksKetik teks={runtimeTemplate ? '__CMS_PROFILE_TITLE__' : judulHalaman} runtimeMarker={runtimeTemplate ? '__CMS_TYPED_PROFILE_TITLE__' : undefined} />
    </h1>
    <p class="mt-4 max-w-2xl text-ink-muted">
      <TeksKetik teks={ringkasan} jedaAwal={jedaSubjudulKetik(judulHalaman)} jedaHuruf={JEDA_HURUF_SUBJUDUL} runtimeMarker={runtimeTemplate ? '__CMS_TYPED_SUMMARY__' : undefined} />
    </p>
    <ul data-motion data-motion-delay="140" class="mt-6 flex flex-wrap gap-2">
      {
        tautanSection.map((item) => (
          <li>
            <a
              href={url(item.anchor)}
              class="inline-flex h-10 items-center rounded-full bg-sage-100 px-4 text-sm font-semibold text-forest-900 transition-colors hover:bg-sage-200"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </Container>
</section>
