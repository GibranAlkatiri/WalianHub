---
// Section 8 Beranda: kontak dan peta. Anchor #kontak untuk tombol "Hubungi Kami".
import type { CollectionEntry } from 'astro:content';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { tautanWhatsapp } from '../../lib/format';

interface Props {
  situs: CollectionEntry<'situs'>['data'];
}

const { situs } = Astro.props;
const { lat, lng } = situs.koordinat;

// Alamat embed Google Maps tanpa API key, langsung ke halaman embed (tanpa pengalihan).
const petaEmbed = `https://www.google.com/maps/embed?origin=mfe&pb=!1m3!2m1!1s${lat},${lng}!6i15`;
const petaGoogle = situs.googleMapsUrl || `https://www.google.com/maps/search/?api=1&query=${lat},${lng}`;
const tautanWa = situs.whatsapp
  ? tautanWhatsapp(situs.whatsapp, 'Halo Kelurahan Walian, saya ingin bertanya tentang layanan kelurahan.')
  : undefined;
const lapor = situs.tautanPenting.find((tautan) => tautan.url.includes('lapor.go.id'));

// Selama alamat kantor masih placeholder, titik peta hanya perkiraan wilayah Walian.
const titikPerkiraan = situs.alamat.includes('[');
---

<section id="kontak" class="bg-white py-16 lg:py-24">
  <Container class="grid gap-10 lg:grid-cols-2 lg:gap-16">
    <div>
      <SectionHeading
        overline="Kontak"
        title="Hubungi Kelurahan Walian"
        description="Datang langsung ke kantor kelurahan, atau hubungi kami lewat telepon dan WhatsApp."
      />

      <ul class="mt-8 space-y-5">
        <li class="flex gap-4">
          <span class="grid size-11 shrink-0 place-items-center rounded-full bg-sage-100 text-forest-600"><Icon name="map-pin" /></span>
          <div>
            <p class="font-semibold text-ink">Alamat kantor</p>
            <p class="text-ink-muted">{situs.alamat}</p>
          </div>
        </li>
        <li class="flex gap-4">
          <span class="grid size-11 shrink-0 place-items-center rounded-full bg-sage-100 text-forest-600"><Icon name="clock" /></span>
          <div>
            <p class="font-semibold text-ink">Jam layanan</p>
            {situs.jamLayanan.map((jam) => <p class="text-ink-muted">{jam.hari}: {jam.jam}</p>)}
          </div>
        </li>
        {
          situs.telepon && (
            <li class="flex gap-4">
              <span class="grid size-11 shrink-0 place-items-center rounded-full bg-sage-100 text-forest-600">
                <Icon name="phone" />
              </span>
              <div>
                <p class="font-semibold text-ink">Telepon</p>
                <p class="text-ink-muted">{situs.telepon}</p>
              </div>
            </li>
          )
        }
        <li class="flex gap-4">
          <span class="grid size-11 shrink-0 place-items-center rounded-full bg-sage-100 text-forest-600"><Icon name="whatsapp" /></span>
          <div>
            <p class="font-semibold text-ink">WhatsApp</p>
            <p class="text-ink-muted">{situs.whatsapp ? `+${situs.whatsapp}` : '[Nomor WhatsApp layanan]'}</p>
          </div>
        </li>
        {
          situs.email && (
            <li class="flex gap-4">
              <span class="grid size-11 shrink-0 place-items-center rounded-full bg-sage-100 text-forest-600">
                <Icon name="mail" />
              </span>
              <div>
                <p class="font-semibold text-ink">Email</p>
                <p class="break-all text-ink-muted">{situs.email}</p>
              </div>
            </li>
          )
        }
      </ul>

      <div class="mt-8 flex flex-wrap gap-3">
        {tautanWa && <Button href={tautanWa} icon="whatsapp">Chat WhatsApp</Button>}
        {lapor && <Button href={lapor.url} variant="outline" iconRight="external-link">Pengaduan lewat LAPOR!</Button>}
      </div>
    </div>

    <div class="flex flex-col gap-4">
      <div class="overflow-hidden rounded-3xl bg-sage-100 shadow-card">
        <iframe
          title="Peta lokasi Kelurahan Walian"
          src={petaEmbed}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="block aspect-[4/3] w-full border-0 lg:aspect-auto lg:h-[440px]"></iframe>
      </div>
      <div class="flex flex-wrap items-center justify-between gap-3">
        {titikPerkiraan && <p class="text-sm text-ink-subtle">Titik peta masih perkiraan wilayah Walian, menunggu titik lokasi kantor kelurahan.</p>}
        <Button href={petaGoogle} variant="outline" iconRight="external-link">Buka di Google Maps</Button>
      </div>
    </div>
  </Container>
</section>
