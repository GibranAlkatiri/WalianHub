---
// Halaman /berita/kategori/<slug>/halaman/2 dan seterusnya: berita satu kategori, per halaman.
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import DaftarBerita from '../../../../../components/berita/DaftarBerita.astro';
import { ambilBeritaTerbit, jumlahHalaman, potongHalaman } from '../../../../../lib/berita';
import { namaKategori, slugKategori, type KategoriBerita } from '../../../../../lib/kategori-berita';

export async function getStaticPaths() {
  const semuaBerita = await ambilBeritaTerbit();
  return namaKategori.flatMap((nama) => {
    const total = jumlahHalaman(semuaBerita.filter((item) => item.data.kategori === nama).length);
    return Array.from({ length: total - 1 }, (_, i) => ({
      params: { kategori: slugKategori(nama), nomor: String(i + 2) },
      props: { kategoriAktif: nama },
    }));
  });
}

interface Props {
  kategoriAktif: KategoriBerita;
}

const { kategoriAktif } = Astro.props;
const halaman = Number(Astro.params.nomor);

const semuaBerita = (await ambilBeritaTerbit()).filter((item) => item.data.kategori === kategoriAktif);
const totalHalaman = jumlahHalaman(semuaBerita.length);
const berita = potongHalaman(semuaBerita, halaman);
---

<BaseLayout
  title={`Berita ${kategoriAktif} · Halaman ${halaman}`}
  description="Berita, pengumuman, dan kegiatan terbaru dari Kelurahan Walian."
>
  <DaftarBerita berita={berita} kategoriAktif={kategoriAktif} halaman={halaman} totalHalaman={totalHalaman} />
</BaseLayout>
