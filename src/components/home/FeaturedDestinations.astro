---
// Section 4 Beranda: destinasi unggulan. Anchor #wisata.
// Sampai empat destinasi: tampilkan semua. Mulai lima: empat pilihan dan tautan halaman daftar.
// Di HP, card bisa digeser ke samping (carousel) dengan titik penanda di bawahnya.
import { wisata } from '../../lib/data-wisata';
import { tautanPetaDestinasi } from '../../lib/wisata';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import DestinationCard from '../ui/DestinationCard.astro';
import Button from '../ui/Button.astro';

const destinasi = wisata.pilihan;
---

<section id="wisata" class="bg-sage-100 py-12 sm:py-16 lg:py-24">
  <Container>
    <SectionHeading
      align="center"
      overline="Wisata"
      title="Destinasi unggulan Walian"
      description="Tempat-tempat menarik di Kelurahan Walian yang bisa Anda kunjungi."
    />

    {destinasi.length === 0 ? (
      <p class="mt-8 rounded-2xl bg-white p-8 text-center text-ink-muted shadow-card">Informasi destinasi wisata sedang disiapkan.</p>
    ) : <div data-carousel class="mt-8 lg:mt-10">
      <div
        data-carousel-lintasan
        class:list={[
          'relative -mx-4 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 py-4 [scrollbar-width:none] md:mx-0 md:grid md:grid-cols-2 md:overflow-visible md:px-0 md:py-0 lg:gap-6 [&::-webkit-scrollbar]:hidden',
          destinasi.length === 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3',
        ]}
      >
        {
          destinasi.map((item) => (
            <div class="w-[85%] max-w-sm shrink-0 snap-center md:w-auto md:max-w-none">
              <DestinationCard
                nama={item.data.nama}
                kategori={item.data.kategori}
                ringkasan={item.data.ringkasan}
                gambar={item.data.gambar}
                href={tautanPetaDestinasi(item.data.lokasi)}
              />
            </div>
          ))
        }
      </div>
      <div aria-hidden="true" class="mt-2 flex justify-center gap-2 md:hidden">
        {
          destinasi.map((_, i) => (
            <span data-carousel-titik class:list={['size-2.5 rounded-full transition-colors', i === 0 ? 'bg-forest-600' : 'bg-line']} />
          ))
        }
      </div>
    </div>}

    {
      wisata.pakaiHalaman && (
        <div class="mt-8 text-center sm:mt-10">
          <Button href="/wisata" variant="outline">Semua Wisata</Button>
        </div>
      )
    }
  </Container>
</section>

<script>
  // Titik penanda carousel di HP: menandai card yang paling dekat ke tengah layar.
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((carousel) => {
    const lintasan = carousel.querySelector<HTMLElement>('[data-carousel-lintasan]');
    const titik = carousel.querySelectorAll<HTMLElement>('[data-carousel-titik]');
    if (!lintasan || titik.length === 0) return;

    const perbarui = () => {
      const tengah = lintasan.scrollLeft + lintasan.clientWidth / 2;
      let aktif = 0;
      let jarakTerdekat = Infinity;
      Array.from(lintasan.children).forEach((kartu, i) => {
        const el = kartu as HTMLElement;
        const jarak = Math.abs(el.offsetLeft + el.offsetWidth / 2 - tengah);
        if (jarak < jarakTerdekat) {
          jarakTerdekat = jarak;
          aktif = i;
        }
      });
      titik.forEach((t, i) => {
        t.classList.toggle('bg-forest-600', i === aktif);
        t.classList.toggle('bg-line', i !== aktif);
      });
    };

    lintasan.addEventListener('scroll', perbarui, { passive: true });
    window.addEventListener('resize', perbarui);
    perbarui();
  });
</script>
