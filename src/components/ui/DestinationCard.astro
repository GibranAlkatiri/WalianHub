---
// Card destinasi: gambar 3:2, kategori, nama, ringkasan, dan tombol "Cek Lokasi".
// href berisi alamat Google Maps titik destinasi, jadi tombol otomatis terbuka di tab baru.
import SmartImage from './SmartImage.astro';
import Badge from './Badge.astro';
import Button from './Button.astro';

interface Props {
  nama: string;
  kategori: string;
  ringkasan: string;
  gambar?: string;
  href: string;
}

const { nama, kategori, ringkasan, gambar, href } = Astro.props;
---

<article
  class="flex h-full flex-col rounded-2xl bg-white p-3 shadow-card transition duration-200 hover:-translate-y-1 hover:shadow-float motion-reduce:transition-none motion-reduce:hover:translate-y-0"
>
  <SmartImage src={gambar} alt={nama} class="aspect-[3/2] rounded-xl" />
  <div class="flex flex-1 flex-col px-2 pt-4 pb-2 lg:px-3">
    <Badge class="self-start">{kategori}</Badge>
    <h3 class="mt-3 text-lg leading-snug font-bold text-ink sm:text-xl">{nama}</h3>
    <p class="mt-2 line-clamp-2 text-base text-ink-muted">{ringkasan}</p>
    <div class="mt-auto pt-5">
      <Button href={href} size="sm" iconRight="external-link">Cek Lokasi<span class="sr-only"> {nama}</span></Button>
    </div>
  </div>
</article>
