---
// Halaman /berita/halaman/2 dan seterusnya: semua berita, per halaman.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DaftarBerita from '../../../components/berita/DaftarBerita.astro';
import { ambilBeritaTerbit, jumlahHalaman, potongHalaman } from '../../../lib/berita';

export async function getStaticPaths() {
  const semuaBerita = await ambilBeritaTerbit();
  const totalHalaman = jumlahHalaman(semuaBerita.length);
  return Array.from({ length: totalHalaman - 1 }, (_, i) => ({
    params: { nomor: String(i + 2) },
  }));
}

const halaman = Number(Astro.params.nomor);

const semuaBerita = await ambilBeritaTerbit();
const totalHalaman = jumlahHalaman(semuaBerita.length);
const berita = potongHalaman(semuaBerita, halaman);
---

<BaseLayout title={`Berita · Halaman ${halaman}`} description="Berita, pengumuman, dan kegiatan terbaru dari Kelurahan Walian.">
  <DaftarBerita berita={berita} halaman={halaman} totalHalaman={totalHalaman} />
</BaseLayout>
