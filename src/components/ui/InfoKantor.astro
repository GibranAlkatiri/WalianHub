---
// Daftar info kantor kelurahan: alamat, jam layanan dengan status langsung, WhatsApp, dan email.
// Dipakai di section Kontak Beranda dan di kepala halaman Layanan, jadi isinya selalu sama.
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { ringkasJadwal } from '../../lib/jam-layanan';
import { formatNomorWhatsapp, tautanWhatsapp } from '../../lib/format';
import { pesanWhatsapp } from '../../lib/navigasi';

interface Props {
  situs: CollectionEntry<'situs'>['data'];
  class?: string;
}

const { situs, class: kelas } = Astro.props;
---

<ul class:list={['space-y-5', kelas]}>
  <li class="flex gap-4">
    <span class="grid size-11 shrink-0 place-items-center rounded-full bg-sage-100 text-forest-600"><Icon name="map-pin" /></span>
    <div>
      <p class="font-semibold text-ink">Alamat kantor</p>
      <p class="text-ink-muted">{situs.alamat}</p>
    </div>
  </li>
  <li class="flex gap-4">
    <span class="grid size-11 shrink-0 place-items-center rounded-full bg-sage-100 text-forest-600"><Icon name="clock" /></span>
    <div>
      <p class="font-semibold text-ink">Jam layanan</p>
      {/* Status langsung menurut waktu WITA. Tersembunyi sampai skrip selesai menghitung statusnya. */}
      <p
        data-status-layanan={JSON.stringify(situs.jamLayanan)}
        class="group/status my-2 hidden w-fit items-center gap-2 rounded-full bg-sage-100 px-3 py-1 text-sm font-semibold text-forest-900 data-[status]:flex"
      >
        <span class="relative size-3 shrink-0" aria-hidden="true">
          <span class="absolute inset-0 hidden animate-ping rounded-full bg-lampu-buka opacity-75 group-data-[status=buka]/status:block motion-reduce:animate-none" />
          <span class="relative block size-3 rounded-full group-data-[status=buka]/status:bg-lampu-buka group-data-[status=istirahat]/status:bg-lampu-istirahat group-data-[status=tutup]/status:bg-lampu-tutup" />
        </span>
        <span>
          <span class="sr-only" data-status-pembaca />
          <span data-status-teks />
        </span>
      </p>
      {ringkasJadwal(situs.jamLayanan.jadwal).map((baris) => <p class="text-ink-muted">{baris.hari}: {baris.jam}</p>)}
      <p class="mt-1 text-sm text-ink-subtle">Tutup pada hari libur nasional dan cuti bersama.</p>
    </div>
  </li>
  {
    situs.whatsapp && (
      <li class="flex gap-4">
        <span class="grid size-11 shrink-0 place-items-center rounded-full bg-sage-100 text-forest-600">
          <Icon name="whatsapp" />
        </span>
        <div>
          <p class="font-semibold text-ink">WhatsApp</p>
          <a
            href={tautanWhatsapp(situs.whatsapp, pesanWhatsapp)}
            target="_blank"
            rel="noopener"
            class="font-semibold text-forest-600 underline underline-offset-4 hover:text-forest-700"
          >
            <span class="sr-only">Chat WhatsApp </span>
            {formatNomorWhatsapp(situs.whatsapp)}
          </a>
        </div>
      </li>
    )
  }
  {
    situs.email && (
      <li class="flex gap-4">
        <span class="grid size-11 shrink-0 place-items-center rounded-full bg-sage-100 text-forest-600">
          <Icon name="mail" />
        </span>
        <div>
          <p class="font-semibold text-ink">Email</p>
          <p class="break-all text-ink-muted">{situs.email}</p>
        </div>
      </li>
    )
  }
</ul>

<script>
  // Status jam layanan di baris "Jam layanan". Dihitung ulang setiap 30 detik dan saat tab dibuka kembali.
  import { statusLayanan, type DataJamLayanan, type StatusLayanan } from '../../lib/jam-layanan';

  // Teks tambahan untuk pembaca layar. Saat istirahat tulisannya tetap "Buka sekarang" dan hanya warna lampu yang berubah,
  // jadi pembaca layar perlu diberi tahu. Buka dan tutup sudah jelas dari tulisannya.
  const teksPembaca: Record<StatusLayanan, string> = {
    buka: '',
    istirahat: 'Kantor sedang istirahat, tetap bisa didatangi. ',
    tutup: '',
  };

  function perbarui() {
    document.querySelectorAll<HTMLElement>('[data-status-layanan]').forEach((el) => {
      const data: DataJamLayanan = JSON.parse(el.dataset.statusLayanan ?? '');
      const { status, teks } = statusLayanan(data, new Date());
      el.dataset.status = status;
      el.querySelector('[data-status-pembaca]')!.textContent = teksPembaca[status];
      el.querySelector('[data-status-teks]')!.textContent = teks;
    });
  }

  perbarui();
  setInterval(perbarui, 30_000);
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) perbarui();
  });
</script>
