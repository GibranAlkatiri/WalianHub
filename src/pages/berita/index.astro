---
// Halaman /berita: semua berita, halaman 1.
import BaseLayout from '../../layouts/BaseLayout.astro';
import DaftarBerita from '../../components/berita/DaftarBerita.astro';
import { ambilBeritaTerbit, jumlahHalaman, potongHalaman } from '../../lib/berita';

const semuaBerita = await ambilBeritaTerbit();
const totalHalaman = jumlahHalaman(semuaBerita.length);
const berita = potongHalaman(semuaBerita, 1);
---

<BaseLayout title="Berita" description="Berita, pengumuman, dan kegiatan terbaru dari Kelurahan Walian.">
  <DaftarBerita berita={berita} halaman={1} totalHalaman={totalHalaman} />
</BaseLayout>
