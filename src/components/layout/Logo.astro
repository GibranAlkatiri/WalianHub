---
// Logo teks sementara: ikon gunung, nama kelurahan, dan nama kota.
// Diganti logo resmi setelah izin penggunaannya didapat.
import Icon from '../ui/Icon.astro';
import { url } from '../../lib/url';

interface Props {
  nama: string;
  keterangan: string;
  /** true untuk latar gelap, misalnya di footer. */
  terang?: boolean;
}

const { nama, keterangan, terang = false } = Astro.props;
---

<a href={url('/')} class="flex shrink-0 items-center gap-2 rounded-xl sm:gap-2.5">
  <span class:list={['grid size-9 place-items-center rounded-xl text-white sm:size-10', terang ? 'bg-white/10' : 'bg-forest-600']}>
    <Icon name="mountain" class="size-5 sm:size-6" />
  </span>
  <span class="leading-tight">
    <span class:list={['block text-[15px] font-extrabold sm:text-base lg:text-lg', terang ? 'text-white' : 'text-forest-600']}>{nama}</span>
    <span class:list={['block text-xs font-medium', terang ? 'text-sage-200' : 'text-ink-subtle']}>{keterangan}</span>
  </span>
</a>
