---
// Header melayang yang tampil di semua halaman.
// Menu lengkap tampil mulai lebar 1280px; di bawahnya memakai hamburger menu di kiri logo.
// Ukuran logo, tombol bahasa, dan hamburger dibuat ringkas di HP agar muat di layar 360px.
// Di Beranda (transparan=true), header tanpa latar saat posisi paling atas, lalu berubah jadi kartu putih setelah di-scroll.
import Logo from './Logo.astro';
import LanguageToggle from './LanguageToggle.astro';
import MobileMenu from './MobileMenu.astro';
import Button from '../ui/Button.astro';
import { menuUtama, tautanKontak } from '../../lib/navigasi';
import { url } from '../../lib/url';

interface Props {
  namaKelurahan: string;
  kecamatan: string;
  kota: string;
  transparan?: boolean;
}

const { namaKelurahan, kecamatan, kota, transparan = false } = Astro.props;

const halamanIni = Astro.url.pathname.replace(/\/$/, '');
const aktif = (href: string) => {
  const tujuan = url(href).replace(/\/$/, '');
  return tujuan === halamanIni || (href !== '/' && halamanIni.startsWith(`${tujuan}/`));
};
---

<header
  class="group fixed inset-x-0 top-0 z-50 px-2 pt-2 sm:px-3 sm:pt-3 lg:px-6 lg:pt-4"
  data-header
  data-transparan={transparan || undefined}
  data-atas={transparan || undefined}
>
  <div
    class="relative mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 rounded-2xl bg-white/95 px-2.5 shadow-float backdrop-blur transition-[background-color,box-shadow] duration-375 group-data-atas:bg-transparent group-data-atas:shadow-none group-data-atas:backdrop-blur-none motion-reduce:transition-none sm:px-3 lg:h-18 lg:px-5"
  >
    <div class="flex items-center gap-1 sm:gap-2">
      <MobileMenu menu={menuUtama} tautanKontak={tautanKontak} />
      <Logo nama={namaKelurahan} kecamatan={kecamatan} kota={kota} />
    </div>

    <nav aria-label="Menu utama" class="hidden xl:block">
      <ul class="flex items-center gap-1">
        {
          menuUtama.map((item) => (
            <li>
              <a
                href={url(item.href)}
                aria-current={aktif(item.halaman ?? item.href) ? 'page' : undefined}
                class:list={[
                  'rounded-full px-3 py-2 text-base font-medium transition-colors hover:text-forest-600 group-data-atas:hover:text-white/80',
                  aktif(item.halaman ?? item.href)
                    ? 'text-forest-600 underline decoration-2 underline-offset-8 group-data-atas:text-white'
                    : 'text-ink group-data-atas:text-white',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-1.5 sm:gap-2">
      <LanguageToggle />
      <div class="hidden xl:block">
        <Button href={tautanKontak}>Hubungi Kami</Button>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');

  if (header && header.dataset.transparan !== undefined) {
    header.toggleAttribute('data-atas', window.scrollY <= 16);
    let frame = 0;
    const aturPosisi = () => {
      frame = 0;
      // Ambang berbeda saat turun/naik mencegah kedipan di sekitar batas.
      if (header.hasAttribute('data-atas') && window.scrollY >= 24) header.removeAttribute('data-atas');
      else if (!header.hasAttribute('data-atas') && window.scrollY <= 8) header.setAttribute('data-atas', '');
    };
    window.addEventListener('scroll', () => { if (!frame) frame = requestAnimationFrame(aturPosisi); }, { passive: true });
  }
</script>
